    <div class="flex-1 space-y-8">

      <section id="m-delivery" class="scroll-mt-24">
        <h2 class="text-lg font-semibold mb-3">Delivery""" + _tip("Delivery health at a glance: work-in-progress flow (CFD), throughput balance (Opened vs Resolved), and how long work takes to actually complete (Cycle Time) vs its total lifetime (Lead Time).") + """</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="widget"><h3 class="font-medium mb-2">Cumulative Flow Diagram""" + _tip("A stacked area chart of Backlog, In Progress and Done over time. The vertical gap between adjacent bands is the work-in-progress (WIP); a widening band signals congestion, while a narrowing one signals flow. Flat 'In Progress' band = work is queued, not being done.") + """</h3><div class="h-48"><canvas id="cfdChart"></canvas></div></div>
          <div class="widget"><h3 class="font-medium mb-2">Opened vs Resolved (biweekly)""" + _tip("Compares issues Opened vs Resolved in each 2-week bucket. When Opened persistently exceeds Resolved, the backlog grows (demand > capacity); the reverse means the team is burning down outstanding work.") + """</h3><div class="h-48"><canvas id="flowChart"></canvas></div></div>
          <div class="widget"><h3 class="font-medium mb-2">Cycle Time""" + _tip("Cycle time = first 'Done/Closed' MINUS first 'In Progress' (from the issue changelog). Formula: avg(Done − In Progress) over completed STORY and TASK issues only (bugs have their own dedicated 'Cycle Time (Bug)' metric). It measures ONLY the active work duration — how long it actually takes to BUILD/complete a feature once started — and EXCLUDES queue/backlog wait. This is the 'how fast do we execute' metric. Compare with Requirements Cycle Time below, which measures the wait BEFORE work starts (In Progress − Created) and is usually larger.") + """</h3>
            <div class="na-box">""" + (f"{avg_cycle:.1f} days avg" if avg_cycle is not None else "N/A") + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Requirements Cycle Time""" + _tip("Time from a requirement being CREATED to it ENTERING DEVELOPMENT (first 'In Progress' transition). Formula: avg(story_dev_start − story_created) for STORY/TASK items entering development in the period (requirements only — excludes bugs). Period = sprint, or 2-week bucket if sprints are absent. It measures how long a requirement WAITS before work starts (incl. backlog/refinement time). HEALTHY = < 1 sprint / 2-week period (<14 days), i.e. requirements don't sit unrefined for more than one iteration. Why it differs from Cycle Time: Cycle Time = Done − In Progress (active build time, all types); Requirements Cycle Time = In Progress − Created (wait time to start, story/task only) — so it is usually larger and reflects the backlog/refinement bottleneck.") + """</h3>
            <div class="na-box">""" + (
              f"{jm['req_cycle_overall']:.1f} days avg · "
              + ("🟢 Healthy (<14d)" if jm.get('req_cycle_overall') is not None and jm['req_cycle_overall'] < 14
                 else "🟠 Watch (≥14d)" if jm.get('req_cycle_overall') is not None else "N/A")
            ) + """</div>
            <div class="overflow-x-auto mt-2">
              <table class="w-full text-sm"><thead><tr class="text-left border-b">
                <th class="py-1">Period (2wk / sprint)</th><th>Avg Days</th><th>Items</th>
              </tr></thead><tbody>""" + (
                "".join(
                  "<tr><td class='py-1'>"+esc(r['period'])+"</td><td class='py-1'>"+
                  (f"{r['avg_days']:.1f}" if r['avg_days'] is not None else "N/A")+
                  "</td><td class='py-1'>"+str(r['count'])+"</td></tr>"
                  for r in jm.get('req_cycle_trend') or [])
                if jm.get('req_cycle_trend') else
                "<tr><td colspan='3' class='py-2 text-gray-400'>No stories/tasks entered development yet</td></tr>"
              ) + """</tbody></table>
            </div>
            <div class="mt-3 text-xs text-gray-500 font-medium">By Team (component)</div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm"><thead><tr class="text-left border-b">
                <th class="py-1">Team</th><th>Avg Days</th><th>Items</th>
              </tr></thead><tbody>""" + (
                "".join(
                  "<tr><td class='py-1'>"+esc(r['team'])+"</td><td class='py-1'>"+
                  (f"{r['avg_days']:.1f}" if r['avg_days'] is not None else "N/A")+
                  "</td><td class='py-1'>"+str(r['count'])+"</td></tr>"
                  for r in jm.get('req_cycle_by_team') or [])
                if jm.get('req_cycle_by_team') else
                "<tr><td colspan='3' class='py-2 text-gray-400'>n/a</td></tr>"
              ) + """</tbody></table>
            </div>
            <div class="mt-3 text-xs text-gray-500 font-medium">By Project</div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm"><thead><tr class="text-left border-b">
                <th class="py-1">Project</th><th>Avg Days</th><th>Items</th>
              </tr></thead><tbody>""" + (
                "".join(
                  "<tr><td class='py-1'>"+esc(r['project'])+"</td><td class='py-1'>"+
                  (f"{r['avg_days']:.1f}" if r['avg_days'] is not None else "N/A")+
                  "</td><td class='py-1'>"+str(r['count'])+"</td></tr>"
                  for r in jm.get('req_cycle_by_project') or [])
                if jm.get('req_cycle_by_project') else
                "<tr><td colspan='3' class='py-2 text-gray-400'>n/a</td></tr>"
              ) + """</tbody></table>
            </div>
            <div class="mt-3 text-xs text-gray-500 font-medium">By Type</div>
            <div class="overflow-x-auto">
              <table class="w-full text-sm"><thead><tr class="text-left border-b">
                <th class="py-1">Type</th><th>Avg Days</th><th>Items</th>
              </tr></thead><tbody>""" + (
                "".join(
                  "<tr><td class='py-1'>"+esc(r['type'])+"</td><td class='py-1'>"+
                  (f"{r['avg_days']:.1f}" if r['avg_days'] is not None else "N/A")+
                  "</td><td class='py-1'>"+str(r['count'])+"</td></tr>"
                  for r in jm.get('req_cycle_by_type') or [])
                if jm.get('req_cycle_by_type') else
                "<tr><td colspan='3' class='py-2 text-gray-400'>n/a</td></tr>"
              ) + """</tbody></table>
            </div></div>
          <div class="widget"><h3 class="font-medium mb-2">Lead Time""" + _tip("Lead time = first 'Done/Closed' MINUS created (from the issue changelog). Formula: avg(Done − Created) over completed STORY and TASK issues only (bugs have their own dedicated 'Lead Time (Bug)' metric). It measures the TOTAL lifetime of a feature, including time spent waiting in the queue/backlog before work began. This is the 'end-to-end delivery' metric (vs Cycle Time, which measures only the active build phase).") + """</h3>
            <div class="na-box">""" + (f"{avg_lead:.1f} days avg" if avg_lead is not None else "N/A") + """</div></div>
          <div class="widget md:col-span-2 relative"><h3 class="font-medium mb-2 flex items-center justify-between"><span class="inline-flex items-center gap-1">Process Metrics - Trends<span id="rcTipBox"></span></span><span class="inline-flex items-center gap-3 text-sm"><button onclick="rcWidgetSettingsToggle()" title="Widget settings" class="inline-flex items-center gap-1 text-gray-500 hover:text-gray-800 leading-none"><span class="text-lg">&#9881;</span>Widget settings</button><button onclick="rcSettingsToggle()" title="Metrics settings" aria-label="Metrics settings" class="text-gray-400 hover:text-gray-700 leading-none"><span class="text-lg">&#9881;</span>Metrics settings</button></span></h3>
            <!-- Widget settings slide-over panel (shared, cross-metric) -->
            <div id="rcWidgetSettingsPanel" class="hidden fixed inset-y-0 right-0 w-[26rem] max-w-full bg-white border-l shadow-xl z-50 overflow-y-auto">
              <div class="flex items-center justify-between px-4 py-3 border-b sticky top-0 bg-white">
                <span class="font-semibold text-sm">Widget settings</span>
                <button onclick="rcWidgetSettingsClose()" class="text-gray-400 hover:text-gray-600 text-xl leading-none" aria-label="Close">&times;</button>
              </div>
              <div id="rcWidgetSettingsBody" class="px-4 py-2"></div>
              <div class="sticky bottom-0 bg-white border-t px-4 py-3 flex flex-wrap gap-2">
                <button onclick="rcWidgetSettingsApply()" class="px-3 py-1.5 rounded bg-blue-600 text-white text-sm">Apply</button>
                <button onclick="rcWidgetSettingsReset()" class="px-3 py-1.5 rounded border text-sm">Reset to defaults</button>
                <button onclick="rcWidgetSettingsExport()" class="px-3 py-1.5 rounded border text-sm">Export JSON</button>
                <button onclick="rcWidgetSettingsImport()" class="px-3 py-1.5 rounded border text-sm">Import</button>
                <span class="text-xs text-gray-400 self-center ml-auto">Shared across all metrics</span>
              </div>
            </div>
            <!-- Metric settings slide-over panel -->
            <div id="rcSettingsPanel" class="hidden fixed inset-y-0 right-0 w-[26rem] max-w-full bg-white border-l shadow-xl z-50 overflow-y-auto">
              <div class="flex items-center justify-between px-4 py-3 border-b sticky top-0 bg-white">
                <span class="font-semibold text-sm">Metrics settings</span>
                <button onclick="rcSettingsClose()" class="text-gray-400 hover:text-gray-600 text-xl leading-none" aria-label="Close">&times;</button>
              </div>
              <div id="rcSettingsBody" class="px-4 py-2"></div>
              <div class="sticky bottom-0 bg-white border-t px-4 py-3 flex flex-wrap gap-2">
                <button onclick="rcSettingsApply()" class="px-3 py-1.5 rounded bg-blue-600 text-white text-sm">Apply</button>
                <button onclick="rcSettingsReset()" class="px-3 py-1.5 rounded border text-sm">Reset to defaults</button>
                <button onclick="rcSettingsExport()" class="px-3 py-1.5 rounded border text-sm">Export JSON</button>
                <button onclick="rcSettingsImport()" class="px-3 py-1.5 rounded border text-sm">Import</button>
                <span class="text-xs text-gray-400 self-center ml-auto">Applies to Trends + used on regeneration via --metric-settings</span>
              </div>
            </div>
            <div class="flex flex-wrap md:flex-nowrap gap-4">
              <div class="w-full md:w-56 shrink-0">
                <div class="text-xs font-semibold text-gray-500 mb-2">Metric</div>
                <button onclick="rcSetMetric('cycle')" id="rcM-cycle" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Requirements Cycle Time</button>
                <button onclick="rcSetMetric('rework')" id="rcM-rework" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Requirements Rework Rate</button>
                <button onclick="rcSetMetric('backlog')" id="rcM-backlog" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Backlog Health</button>
                <button onclick="rcSetMetric('flow')" id="rcM-flow" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Opened vs Resolved</button>
                <button onclick="rcSetMetric('cycletime')" id="rcM-cycletime" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Cycle Time</button>
                <button onclick="rcSetMetric('lead')" id="rcM-lead" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Lead Time</button>
                <button onclick="rcSetMetric('velocity')" id="rcM-velocity" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Velocity</button>
                <button onclick="rcSetMetric('throughput')" id="rcM-throughput" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Throughput</button>
                <button onclick="rcSetMetric('wip')" id="rcM-wip" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Work in Progress</button>
                <button onclick="rcSetMetric('floweff')" id="rcM-floweff" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Flow Efficiency</button>
                <button onclick="rcSetMetric('leakage')" id="rcM-leakage" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Defect Containment / Production Leakage</button>
                <button onclick="rcSetMetric('defectdensity')" id="rcM-defectdensity" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Defect Density</button>
                <button onclick="rcSetMetric('incident')" id="rcM-incident" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Incident Frequency</button>
                <button onclick="rcSetMetric('bugflow')" id="rcM-bugflow" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Bug Growth (new vs resolved)</button>
                <button onclick="rcSetMetric('bugfix')" id="rcM-bugfix" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Bug Fixing Time Allocation</button>
                <button onclick="rcSetMetric('qa')" id="rcM-qa" class="block w-full text-left px-3 py-2 mb-2 rounded border text-sm">Time in QA</button>
              </div>
              <div class="w-full">
                <div class="flex flex-wrap items-center gap-3 mb-3 text-sm">
                  <label class="flex items-center gap-1">Periods
                    <select id="rcPeriods" onchange="rcPeriodsChanged()" class="border rounded px-2 py-1 text-sm">
                      <option value="daily">Daily</option>
                      <option value="weekly">Weekly</option>
                      <option value="sprint" selected>Sprint (2 weeks)</option>
                      <option value="monthly">Monthly</option>
                      <option value="quarterly">Quarterly</option>
                      <option value="annual">Annual</option>
                    </select>
                  </label>
                  <label class="flex items-center gap-1">From
                    <input type="date" id="rcFrom" onchange="rcCalTouched=true;rcMarkPending()" class="border rounded px-2 py-1 text-sm">
                  </label>
                  <label class="flex items-center gap-1">To
                    <input type="date" id="rcTo" onchange="rcCalTouched=true;rcMarkPending()" class="border rounded px-2 py-1 text-sm">
                  </label>
                  <label class="flex items-center gap-1">Dimensions
                    <select id="rcDim" onchange="rcPopulateDim();rcMarkPending()" class="border rounded px-2 py-1 text-sm">
                      <option value="project">Project (default)</option>
                      <option value="team">Team</option>
                      <option value="component">Component</option>
                      <option value="epic">Epic</option>
                      <option value="person">Person</option>
                    </select>
                  </label>
                  <label class="flex items-center gap-1">Select (multi)
                    <span id="rcDimWrap" class="inline-flex flex-wrap gap-2 items-center"></span>
                  </label>
                  <label class="flex items-center gap-1">Issue Type (multi)
                    <span id="rcTypeWrap" class="inline-flex flex-wrap gap-2 items-center"></span>
                  </label>
                  <button id="rcApplyBtn" onclick="rcApply()" class="px-3 py-1 rounded bg-blue-600 text-white text-sm">Apply</button>
                  <span id="rcConclusion" class="ml-auto font-medium text-sm"></span>
                </div>
                <!-- Weighted average over the selected window (top-right, under the trend conclusion) -->
                <div class="flex justify-end mb-2">
                  <span id="rcAvgBox" class="hidden font-semibold text-sm px-3 py-1.5 rounded border border-blue-200 bg-blue-50 text-blue-800"></span>
                </div>
                <div id="rcDimList" class="flex flex-wrap gap-2 mb-2 text-sm"></div>
                <div class="h-80"><canvas id="rcChart"></canvas></div>
                <p id="rcAxisNote" class="text-xs text-gray-500 mt-1">Y-axis: Requirements Cycle Time (days) · X-axis: period (sprint / 2-week bucket). Default shows the last 5 periods with project activity.</p>
                <!-- Issues participating in the current calculation -->
                <div class="mt-3">
                  <div class="flex items-center justify-between mb-1">
                    <div class="text-xs font-semibold text-gray-500">Issues in calculation</div>
                    <div id="rcTblCount" class="text-xs text-gray-500"></div>
                  </div>
                  <div class="overflow-auto border rounded" style="max-height:26rem;">
                    <table class="w-full text-sm">
                      <thead class="sticky top-0 bg-gray-50 text-xs text-gray-600">
                        <tr>
                          <th class="py-1.5 px-2 text-left cursor-pointer select-none" onclick="rcSortTable('id')">ID</th>
                          <th class="py-1.5 px-2 text-left cursor-pointer select-none" onclick="rcSortTable('type')">Issue Type</th>
                          <th class="py-1.5 px-2 text-left cursor-pointer select-none" onclick="rcSortTable('summary')">Issue</th>
                          <th class="py-1.5 px-2 text-left cursor-pointer select-none" onclick="rcSortTable('status')">Status</th>
                          <th class="py-1.5 px-2 text-left cursor-pointer select-none" onclick="rcSortTable('created')">Created</th>
                          <th class="py-1.5 px-2 text-left cursor-pointer select-none" onclick="rcSortTable('updated')">Updated</th>
                          <th class="py-1.5 px-2 text-left cursor-pointer select-none" onclick="rcSortTable('days_in_status')">Days in Status</th>
                        </tr>
                      </thead>
                      <tbody id="rcTableBody"></tbody>
                    </table>
                  </div>
                  <div class="flex items-center justify-between mt-1">
                    <span id="rcPageInfo" class="text-xs text-gray-500"></span>
                    <span>
                      <button onclick="rcPage(-1)" id="rcPrevBtn" class="px-2 py-0.5 border rounded text-xs">Prev</button>
                      <button onclick="rcPage(1)" id="rcNextBtn" class="px-3 py-0.5 border rounded text-xs">Next</button>
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="m-scope" class="scroll-mt-24">
        <h2 class="text-lg font-semibold mb-3">Scope & Predictability""" + _tip("How much the team delivers and how predictably: throughput and velocity, backlog readiness, scope-change churn, and aging work. Together these reveal whether delivery is stable or slipping.") + """</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="widget"><h3 class="font-medium mb-2">Throughput (completed per 2-week period)""" + _tip("Number of issues completed in each 2-week period (any issue type). Throughput is a raw capacity measure; velocity below is a filtered, more refined one.") + """</h3><div class="h-48"><canvas id="throughputChart"></canvas></div></div>
          <div class="widget"><h3 class="font-medium mb-2">Velocity (completed Story/Task/Bug per 2-week period)""" + _tip("Number of Story/Task/Bug issues completed per 2-week period. Velocity is the team's realized capacity and is the basis for forecasting how much can be committed in future iterations.") + """</h3><div class="h-48"><canvas id="velocityChart"></canvas></div></div>
          <div class="widget"><h3 class="font-medium mb-2">Average Velocity (2-week)""" + _tip("The mean of the per-period velocity values. A stable average supports commitment and forecasting; large swings indicate unpredictability.") + """</h3>
            <div class="na-box">""" + (f"{avg_velocity2} /2wk" if avg_velocity2 is not None else "N/A") + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Backlog Health — Ready for Development""" + _tip("Number of issues currently in the 'Ready for Development' state. A healthy backlog keeps enough groomed, ready-to-start work so the team never starves for input.") + """</h3>
            <div class="na-box">""" + (f"{ready_count} items" if ready_count else "N/A") + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Sprint Scope Stability""" + _tip("How stable committed sprint scope is (added vs removed items). High instability means the team commits to work that is later dropped or expanded mid-sprint — a predictability risk.") + """</h3><div class="na-box">N/A (no sprints)</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Avg Scope Change Volume (changed issues)""" + _tip("Average number of changed Story/Task/Bug issues (at least one status transition) per period. Per sprint when sprints exist, otherwise per 2-week period. High churn indicates unstable requirements or poor upfront planning.") + """</h3>
            <div class="na-box">""" + (
              (f"{jm['avg_scope_change_sprint']} / sprint"
               if jm.get('avg_scope_change_sprint') is not None else
               f"{jm['avg_scope_change_2wk']} / 2wk"
               if jm.get('avg_scope_change_2wk') is not None else "N/A")
            ) + """</div></div>
          <div class="widget md:col-span-2"><h3 class="font-medium mb-2">Scope Change Volume by 2-week period (changed issues)""" + _tip("Per-period count of issues (Story/Task/Bug) that changed status AT LEAST ONCE — ANY transition (New→Open, Open→In Progress, In Progress→Resolved, ...). This is a BROAD 'churn' metric: it counts every issue that moved, including normal forward progress. Spikes show periods of heavy rework/scope drift; a flat low line reflects a stable pipeline. DIFFERENCE vs Requirements Rework Rate: Scope Change counts ALL status changes (any direction), while Rework Rate counts ONLY returns to requirements/refinement (New/Open/To Do/Backlog/Reopened/Analysis/Design/Ready for Dev) AFTER dev started. So Scope Change is always larger — it is a volume of movement, not a rate of rework.") + """</h3><div class="h-48"><canvas id="scopeChangeChart"></canvas></div></div>
          <div class="widget"><h3 class="font-medium mb-2">Top Areas / Components (work)""" + _tip("Where the work is concentrated: the top 12 components by issue count. Helps spot overloaded areas and understand the shape of the delivery portfolio.") + """</h3>
            <table class="w-full text-sm"><thead><tr class="text-left border-b"><th class="py-2">Component</th><th>Issues</th></tr></thead><tbody>
            """ + ("".join(f"<tr><td>{esc(k)}</td><td>{v}</td></tr>" for k, v in list(jm.get('by_component', {}).items())[:12]) or "<tr><td colspan='2'>N/A</td></tr>") + """</tbody></table></div>
          <div class="widget"><h3 class="font-medium mb-2">Aging Issues (>30 days)""" + _tip("Issues that have stayed open for more than 30 days, with their current status and priority. Aging work is at risk of becoming stale, blocked, or forgotten — a candidate for escalation or de-scoping.") + """</h3>
            <table class="w-full text-sm"><thead><tr class="text-left border-b"><th class="py-2">Age</th><th>Issue</th><th>Status</th><th>Priority</th><th>Link</th></tr></thead><tbody>""" + aging_rows + """</tbody></table></div>
        </div>
        <div class="widget mt-4"><h3 class="font-medium mb-2">Ready for Development — Items""" + _tip("The actual list of issues sitting in 'Ready for Development', with priority and a link to each. This is the groomed, startable queue the team should pull from next.") + """</h3>
          <table class="w-full text-sm"><thead><tr class="text-left border-b"><th class="py-2">Issue</th><th>Priority</th><th>Link</th></tr></thead><tbody>""" + ready_rows + """</tbody></table>
        </div>
      </section>

      <section id="m-quality" class="scroll-mt-24">
        <h2 class="text-lg font-semibold mb-3">Quality & Technical Debt""" + _tip("The cost of quality: bug trends, defect aging, bug-fixing cycle time, production leakage, and security findings. High values here erode velocity and inflate future maintenance.") + """</h2>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="widget"><h3 class="font-medium mb-2">Bug Growth (new vs resolved)""" + _tip("Compares new bugs opened vs bugs resolved over time (weekly). When new bugs outpace resolved, the defect backlog grows and quality is deteriorating.") + """</h3><div class="h-48"><canvas id="bugChart"></canvas></div></div>
          <div class="widget"><h3 class="font-medium mb-2">Open Bugs by Priority""" + _tip("Distribution of currently-open bugs across priority levels. A heavy high-priority slice means urgent defects are competing for capacity with planned work.") + """</h3><div class="h-48"><canvas id="bugPrioChart"></canvas></div></div>
          <div class="widget"><h3 class="font-medium mb-2">Average Defect Age by Priority""" + _tip("For open bugs of each priority, how old they are on average (days since created). Critical/High defects aging for a long time signal that serious issues are being neglected.") + """</h3>
            <table class="w-full text-sm"><thead><tr class="text-left border-b"><th class="py-2">Priority</th><th>Count</th><th>Avg Age</th></tr></thead><tbody>""" + defect_age_rows + """</tbody></table></div>
          <div class="widget"><h3 class="font-medium mb-2">Cycle Time (Bug)""" + _tip("Cycle time for Bug/Sub-Bug = first 'Done/Closed' minus first 'In Progress' (from the issue changelog). Measures the active bug-fixing duration; lead time (created → done) is shown below and includes queue wait.") + """</h3>
            <div class="na-box">""" + (
              f"{jm['avg_bug_cycle']:.1f} days avg cycle ({jm['bug_cycle_count']} bugs)"
              if jm.get('avg_bug_cycle') is not None else "N/A"
            ) + """</div>
            <p class="text-xs text-gray-500 mt-2">Lead time (created → done): <strong>""" + (
              f"{jm['avg_bug_lead']:.1f} days" if jm.get('avg_bug_lead') is not None else "N/A"
            ) + """</strong></p>
          </div>
          <div class="widget"><h3 class="font-medium mb-2">Defect Containment / Production Leakage""" + _tip("Bugs tagged 'Prod' indicate defects found in production (leaked past QA). The leakage rate = prod bugs ÷ total bugs × 100. A high rate means defects are escaping testing and reaching end users.") + """</h3>
            <div class="na-box">""" + (
              f"{jm['defect_leakage_rate']:.1f}% leaked ({jm['prod_bugs']}/{jm['total_bugs']} prod bugs)"
              if jm.get('defect_leakage_rate') is not None else "N/A (no prod-tagged bugs)"
            ) + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Security Posture (SAST/CWE)""" + _tip("SAST/CWE-labeled findings and open security issues. Counts the number of static-analysis findings, security-type issues, and how many remain open — a proxy for application security debt.") + """</h3>
            <div class="na-box">""" + (
              f"{jm.get('sast_issues', 0)} SAST/CWE findings · {jm.get('sec_type_issues', 0)} security issues ({jm.get('sec_open', 0)} open)"
              if jm.get('sast_issues') else "N/A (no SAST/security data)"
            ) + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Bug Fixing Time Allocation""" + _tip("Share of team time spent on fixing bugs vs building new features (from time-tracking fields). Not available when the project does not log work time.") + """</h3><div class="na-box">N/A (no time-tracking)</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Quality Debts (open defects by priority)""" + _tip("Number of open defects at each priority level. This is the live quality debt the team must pay down — high-priority open defects should be addressed first.") + """</h3>
            <table class="w-full text-sm"><thead><tr class="text-left border-b"><th class="py-2">Priority</th><th>Open</th></tr></thead><tbody>
            """ + "".join(f"<tr><td>{esc(p)}</td><td>{v}</td></tr>" for p, v in jm["open_bug_by_prio"].items()) + """</tbody></table></div>
          <div class="widget"><h3 class="font-medium mb-2">Security Findings by CWE""" + _tip("Security findings grouped by CWE (Common Weakness Enumeration) code. Grouping by CWE reveals which vulnerability classes recur most and should be fixed at the root.") + """</h3>
            <table class="w-full text-sm"><thead><tr class="text-left border-b"><th class="py-2">CWE</th><th>Count</th></tr></thead><tbody>
            """ + ("".join(f"<tr><td>{esc(k)}</td><td>{v}</td></tr>" for k, v in list(jm.get('cwe_by_code', {}).items())[:10]) or "<tr><td colspan='2'>N/A</td></tr>") + """</tbody></table></div>
        </div>
      </section>

      <section id="m-reports" class="scroll-mt-24">
        <h2 class="text-lg font-semibold mb-3">Project Jira Reports""" + _tip("Native Jira Agile/GreenHopper reports (Control Chart, Epic, Velocity, CFD, Scope Change, Forecast, Sprint) fetched from the Jira API and stored in the product_jira_reports Chroma collection. Reports the API does not expose for this project render N/A.") + """</h2>
        <p class="text-xs text-gray-500 mb-3">Reports fetched from the Jira Agile/GreenHopper API and stored in the <span class="font-mono">product_jira_reports</span> Chroma collection. Reports not available via the API for this project render <strong>N/A</strong>.</p>
        <div class="grid md:grid-cols-2 gap-4">
          <div class="widget"><h3 class="font-medium mb-2">Control Chart (cycle time)""" + _tip("Scatter/percentile chart of each completed issue's cycle time. The median and 85th-percentile lines help set realistic cycle-time expectations and spot outliers that took far longer than normal.") + """</h3><div class="overflow-x-auto">""" + control_chart_html + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Epic Report""" + _tip("Progress of Epics: how many of their stories/issues are completed vs outstanding. Shows whether large bodies of work are on track or stalled.") + """</h3><div class="overflow-x-auto">""" + epic_report_html + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Velocity Chart""" + _tip("Jira's velocity report: completed story points (or issue counts) per sprint, with the average. Used to calibrate how much the team can commit to in future sprints.") + """</h3><div class="overflow-x-auto">""" + velocity_chart_html + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Cumulative Flow Diagram (report)""" + _tip("Jira's CFD: cumulative counts of issues across statuses over time. Band widths reveal WIP and cycle-time pressure per status.") + """</h3><div class="overflow-x-auto">""" + cfd_chart_html + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Scope Change Chart""" + _tip("Jira's scope-change report: how much work was added to or removed from sprints after commitment. Large changes signal scope instability and reduce predictability.") + """</h3><div class="overflow-x-auto">""" + scope_change_html + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Forecast Chart""" + _tip("Jira's forecast: projects how many sprints/iterations are needed to complete the remaining backlog based on observed velocity. A planning aid, not a guarantee.") + """</h3><div class="overflow-x-auto">""" + forecast_chart_html + """</div></div>
          <div class="widget"><h3 class="font-medium mb-2">Sprint Report""" + _tip("Details of each sprint: committed vs completed scope, start/end dates, and whether the sprint goal was met. Reveals completion rate and the gap between commitment and delivery.") + """</h3><div class="overflow-x-auto">""" + sprint_report_html + """</div></div>
        </div>
      </section>

    </div>
  </div>
</div>
</div>

""" + tab3_html + """
<script>
function switchTab(n){
  document.getElementById('tab1').classList.toggle('active', n===1);
  document.getElementById('tab2').classList.toggle('active', n===2);
  document.getElementById('tab3').classList.toggle('active', n===3);
  document.getElementById('tab1btn').classList.toggle('active', n===1);
  document.getElementById('tab2btn').classList.toggle('active', n===2);
  document.getElementById('tab3btn').classList.toggle('active', n===3);
  // refresh charts when shown
  if(n===2){ setTimeout(()=>{ Object.values(Chart.instances||{}).forEach(c=>c.resize()); }, 50); }
  // render mermaid diagrams when tab 3 is shown (only unprocessed ones)
  if(n===3 && window.mermaid){
    setTimeout(()=>{
      var nodes = Array.prototype.filter.call(document.querySelectorAll('#tab3 .mermaid'),
        function(el){ return !el.getAttribute('data-processed'); });
      if(nodes.length){ mermaid.run({ nodes: nodes }); }
    }, 50);
  }
}
document.querySelectorAll('.sidebar-link').forEach(a=>{
  a.addEventListener('click', ()=>{ document.querySelectorAll('.sidebar-link').forEach(x=>x.classList.remove('active')); a.classList.add('active'); });
});

// CFD
new Chart(document.getElementById('cfdChart'), { type:'line', data:{
  labels:""" + cfd_weeks + """,
  datasets:[
    {label:'Done', data:""" + cfd_done + """, borderColor:'#10b981', fill:'origin'},
    {label:'In Progress', data:""" + cfd_ip + """, borderColor:'#f59e0b', fill:'-1'},
    {label:'Backlog', data:""" + cfd_backlog + """, borderColor:'#2563eb', fill:'-1'}
  ]}, options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{position:'bottom'}}} });

// Opened vs Resolved (biweekly)
new Chart(document.getElementById('flowChart'), { type:'bar', data:{
  labels:""" + week2_labels + """,
  datasets:[
    {label:'Opened', data:""" + opened2 + """, backgroundColor:'#2563eb'},
    {label:'Resolved', data:""" + resolved2 + """, backgroundColor:'#10b981'}
  ]}, options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{position:'bottom'}}} });

// Throughput (biweekly)
new Chart(document.getElementById('throughputChart'), { type:'bar', data:{
  labels:""" + week2_labels + """,
  datasets:[{label:'Completed (2wk)', data:""" + resolved2 + """, backgroundColor:'#10b981'}]
  }, options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}} });

// Velocity (Story/Task/Bug completed per 2-week period)
new Chart(document.getElementById('velocityChart'), { type:'bar', data:{
  labels:""" + week2_labels + """,
  datasets:[{label:'Velocity', data:""" + velocity2 + """, backgroundColor:'#8b5cf6'}]
  }, options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}} });

// Scope Change Volume (changed Story/Task/Bug per 2-week period)
new Chart(document.getElementById('scopeChangeChart'), { type:'bar', data:{
  labels:""" + week2_labels + """,
  datasets:[{label:'Changed issues', data:""" + scope_change2 + """, backgroundColor:'#f59e0b'}]
  }, options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}} });

// Bug growth
new Chart(document.getElementById('bugChart'), { type:'line', data:{
  labels:""" + week_labels + """,
  datasets:[
    {label:'New Bugs', data:""" + bug_new + """, borderColor:'#ef4444'},
    {label:'Resolved Bugs', data:""" + bug_res + """, borderColor:'#10b981'}
  ]}, options:{responsive:true, maintainAspectRatio:false, plugins:{legend:{position:'bottom'}}} });

// Open bugs by priority
new Chart(document.getElementById('bugPrioChart'), { type:'doughnut', data:{
  labels:""" + js_list(list(jm["open_bug_by_prio"].keys())) + """,
  datasets:[{data:""" + js_list(list(jm["open_bug_by_prio"].values())) + """, backgroundColor:['#ef4444','#f59e0b','#2563eb','#94a3b8']}]
