# Environment variables — ALL .env files (any variant / any folder) are secret
# and must never be committed to git.
.env
.env.*
.env.*.local
**/.env
**/.env.*
**/.env.*.local
# ...but keep the documentation TEMPLATE (.env.example) trackable.
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
# NOTE: DEDAA/lib/ is the dashboard SOURCE (chart_render/chart_config/…),
# NOT a Python build directory — keep it tracked.
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Testing
.pytest_cache/
.coverage
htmlcov/

# Project data — per-project ChromaDB folders, OLAP cubes and generated
# dashboards are runtime artifacts and must never be committed.
# [P14] Default artifact names are project-prefixed:
#   <project>_analytics_dashboard.html / <project>_jira_data_cube.csv
vector_dbs/
analytics_dashboard.html
jira_data_cube.csv
**/analytics_dashboard.html
**/jira_data_cube.csv
**/*_analytics_dashboard.html
**/*_jira_data_cube.csv
**/*_jira_data_cube_crosslink.csv
chroma.sqlite3
