# ============================================================================
#  .env.example  —  Skill #1 (sync_agent.py) & Skill #2 (analyze_agent.py)
# ============================================================================
# Copy this file to `.env` and fill in your real values:
#   cp .env.example .env
#
# Skill #1 (synchronize) : python sync_agent.py --service jira --project-key <PROJECT_KEY>
# Skill #2 (analyze)     : python analyze_agent.py            (dashboard + OLAP cube)
#
# IMPORTANT: every `.env*` file is git-ignored (see .gitignore). Never commit
# real credentials. Keep this file (.env.example) as the documentation template.
#
# Both tools resolve the project's ChromaDB folder from: --db-path / DB_PATH /
# --alias / PROJECT_ALIAS / JIRA_PROJECT (see below).

# ----------------------------------------------------------------------------
# Jira
# ----------------------------------------------------------------------------
JIRA_URL=https://jira.example.com
JIRA_USERNAME=you@company.com
JIRA_TOKEN=<your-jira-api-token>
JIRA_PROJECT=<PROJECT_KEY>       # default project key used to auto-name the DB folder

# ----------------------------------------------------------------------------
# Confluence
# ----------------------------------------------------------------------------
CONFLUENCE_URL=https://confluence.example.com
CONFLUENCE_USERNAME=you@company.com
CONFLUENCE_TOKEN=<your-confluence-api-token>
# Option A: extract a whole Confluence SPACE (all pages via CQL search).
CONFLUENCE_SPACE_KEY=<SPACE_KEY>
# Option B: extract a single page tree from a root page id.
CONFLUENCE_PAGE_ID=<page-id>

# ----------------------------------------------------------------------------
# ChromaDB folder (per-project isolation)
# ----------------------------------------------------------------------------
# Each project is stored in its OWN isolated, portable ChromaDB folder so the
# vector DB can be handed to other agents or the customer.
#
# Option A (recommended): let the tool auto-name the folder.
#   * default: ./vector_dbs/<project-key>
#   * with PROJECT_ALIAS: ./vector_dbs/<alias>
PROJECT_ALIAS=<folder-alias>    # optional friendly folder alias

# Option B: force an explicit folder (overrides auto-naming).
# DB_PATH=./vector_dbs/<PROJECT_KEY>
#
# ALL of a project's data lives in ONE folder: the ChromaDB (chroma.sqlite3,
# assets/, vector segments) plus the Skill #2 outputs (analytics_dashboard.html
# and jira_data_cube.csv). New project -> new folder; re-run -> updates it.

# ----------------------------------------------------------------------------
# ChromaDB access (Python library — no MCP)
# ----------------------------------------------------------------------------
# Both tools access ChromaDB directly via the `chromadb` Python library
# (chromadb.PersistentClient). No MCP server, no npx/NodeJS, no extra tokens
# are required. The DB folder is auto-created if missing. You normally do NOT
# need to set anything extra here.
