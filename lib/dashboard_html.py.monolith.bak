    axis_note:'Y-axis: Completed issues · X-axis: period (sprint / 2-week bucket). Default shows the last 5 periods with project activity.'},
  velocity: {label:'Velocity (Story/Task/Bug)', color:'#8b5cf6', aggregation:'count',
    field:null, y_axis:'Completed Story/Task/Bug', threshold:0.1, y_min:0, y_max:null,
    types:['Story','Task','Defect'], trend_dir:'up',
    axis_note:'Y-axis: Completed Story/Task/Bug · X-axis: period (sprint / 2-week bucket). Default shows the last 5 periods with project activity.'},
  cycletime: {label:'Cycle Time (avg days)', color:'#f59e0b', aggregation:'avg',
    field:'days', y_axis:'Cycle Time (days)', threshold:0.05, y_min:null, y_max:null,
    types:['Story','Task'],
    axis_note:'Y-axis: Cycle Time (days) · X-axis: period (sprint / 2-week bucket). Default shows the last 5 periods with project activity.'},
  backlog: {label:'Backlog Health (sprints of ready work)', color:'#14b8a6', aggregation:'coverage',
    field:null, y_axis:'Sprints of ready backlog', threshold:0.1, y_min:0, y_max:null,
    types:['Story','Task'],
    axis_note:'Y-axis: sprints of ready backlog (ready items ÷ avg team speed per period) · X-axis: period (sprint / 2-week bucket). Healthy band: 2–3 sprints of coverage. Default shows the last 5 periods with project activity.'},
  bugflow: {label:'Bug Growth (new vs resolved)', color:'#ef4444', aggregation:'flow',
    field:'series', y_axis:'Bugs', threshold:0.1, y_min:0, y_max:null,
    types:['Defect'],
    axis_note:'Y-axis: Bugs new/resolved · X-axis: period (sprint / 2-week bucket). Default shows the last 5 periods with project activity.'},
  // [FIX-A2] Leakage: escape-rate semantics (roles rate mode, qaSet denominator).
  leakage: {label:'Defect Containment / Production Leakage', color:'#ec4899', aggregation:'rate',
    rateMode:'roles', field:null, y_axis:'Leakage rate (%)', threshold:0.1, y_min:0, y_max:100,
    types:['Defect','Sub-bug'],
    axis_note:'Y-axis: % of tested-or-prod bugs leaked to production · X-axis: period (sprint / 2-week bucket). Default shows the last 5 periods with project activity.'},
  // [FIX-A5] Bug Fixing Time Allocation: worklog-based % (N/A without timeSpent).
  bugfix: {label:'Bug Fixing Time Allocation', color:'#f97316', aggregation:'allocation',
    requires:'timeSpent', field:null, y_axis:'Allocation (%)', threshold:0.05, y_min:0, y_max:100,
    types:['Defect','Sub-bug'],
    axis_note:'Y-axis: % of logged work time spent on Bug/Sub-bug · X-axis: period (sprint / 2-week bucket). Requires Jira worklog. Healthy: < 20%. Default shows the last 5 periods with project activity.'},
  incident: {label:'Incident Frequency', color:'#f43f5e', aggregation:'grouped',
    field:'severity', y_axis:'Prod bugs', threshold:0.1, y_min:0, y_max:null,
    groups:['Critical','Major','Minor'], colors:{Critical:'#dc2626',Major:'#f59e0b',Minor:'#10b981'},
    types:['Defect'],
    axis_note:'Y-axis: Production bugs (incidents) · X-axis: period (sprint / 2-week bucket). Stacked by severity (Critical/Major/Minor). Default shows the last 5 periods with project activity.'},
  qa: {label:'Time in QA (avg days)', color:'#06b6d4', aggregation:'avg',
    field:'days', y_axis:'Time in QA (days)', threshold:0.05, y_min:null, y_max:null,
    types:['Story','Task'],
    axis_note:'Y-axis: Time in QA (days) · X-axis: period (sprint / 2-week bucket). Time from entering QA (Ready for QA / In Testing) to Done. Default shows the last 5 periods with project activity.'},
  // [FIX-A1] Defect Density: per_sp / per_item two-level formula.
  defectdensity: {label:'Defect Density', color:'#8b5cf6', aggregation:'rate',
    rateMode:'spDensity', field:null, y_axis:'Defect density (ratio)', threshold:0.1, y_min:0, y_max:null,
    types:['Story','Task','Defect','Sub-bug'], trend_dir:'down',
    axis_note:'Y-axis: SP of defects ÷ SP of completed Story/Task (or #defects ÷ #(Story+Task) without story points) per period · X-axis: period (sprint / 2-week bucket). High density signals messy logic / rushed coding / high cyclomatic complexity. Default shows the last 5 periods with project activity.'},
  // [FIX-A4] WIP: point-in-time snapshot at each bucket end (NOT inflow).
  wip: {label:'Work in Progress (WIP)', color:'#f59e0b', aggregation:'wipSnapshot',
    field:null, y_axis:'WIP items (snapshot)', threshold:0.1, y_min:0, y_max:null,
    types:['Story','Task','Defect','Sub-bug'],
    axis_note:'Y-axis: items in a dev status at each period end (snapshot) · X-axis: period (sprint / 2-week bucket). High WIP → high context switching → slower flow. Target: WIP per developer ≤ 1.5. Default shows the last 5 periods with project activity.'},
  floweff: {label:'Flow Efficiency (%)', color:'#10b981', aggregation:'avg',
    field:'eff', y_axis:'Flow Efficiency (%)', threshold:0.5, y_min:0, y_max:100,
    types:['Story','Task'], trend_dir:'up', avg_unit:'%',
    axis_note:'Y-axis: Active work time ÷ total elapsed × 100% · X-axis: period (sprint / 2-week bucket). Active = In Progress → Done; total = Created → Done. Default shows the last 5 periods with project activity.'}
};
var RC_TIP = {
  cycle: "Requirements Cycle Time = avg(In Progress − Created) for Story/Task. Measures how long a requirement waits to enter development (queue/refinement time). HEALTHY < 14 days (1 sprint). The blue box (top-right) shows the weighted average over the selected window: total days ÷ number of items, respecting all filters.",
  rework: "Requirements Rework Rate = % of started Story/Task that return to requirements/refinement AFTER dev started. Formula: (returned to refinement after dev start) ÷ (total started) × 100. HEALTHY < 10%; >20% = requirements-quality problem. DIFFERENCE vs Scope Change: Scope Change counts ANY status change; Rework counts ONLY returns to refinement after dev start. The box shows the weighted average = total reworked ÷ total started over the window.",
  // [FIX-A3] Lead Time: any Issue Type, no DORA references.
  lead: "Lead Time = avg(Done − Created) for any selected Issue Type. Pick Defect + Sub-bug to see Bug Lead Time; pick Story + Task to see Story/Task Lead Time. Includes queue/backlog wait (vs Cycle Time = only the active build phase). HEALTHY < 30 days. The box shows the weighted average over the window: total days ÷ number of items.",
  flow: "Opened vs Resolved per 2-week period for requirements work (Story/Task by default — broaden via the Issue Type filter). If Opened persistently > Resolved the backlog grows (demand > capacity); the reverse means the team is burning down outstanding work. The box shows the average per period for each series (Avg Opened / Avg Resolved) over the window.",
  throughput: "Throughput = number of issues completed per 2-week period (Story/Task/Defect by default — broaden via the Issue Type filter). A raw capacity measure; Velocity is a filtered, more refined version. Higher is better: a rising trend is Improving, a falling trend is Degrading. The box shows the average completed per period over the window.",
  velocity: "Velocity = number of Story/Task/Bug issues completed per 2-week period. The team's realized capacity and the basis for forecasting. Higher is better: a rising trend is Improving, a falling trend is Degrading. The box shows the average completed per period over the window.",
  // [FIX-A6] Cycle Time works for any Issue Type via the top filter.
  cycletime: "Cycle Time = avg(first Done − first In Progress) for any selected Issue Type — pick Defect + Sub-bug to see Bug Cycle Time; pick Story + Task to see Story/Task Cycle Time. Measures only the active execution phase (excludes queue/backlog wait). HEALTHY < 14 days. The box shows the weighted average over the window: total days ÷ number of items.",
  backlog: "Backlog Health = HOW MANY SPRINTS of ready work the backlog holds. Formula: ready items (Story+Task in 'Ready for development'; Defects excluded by default) at each period end ÷ team speed per period. Team speed = Average Velocity in story points per period ONLY when the project has sprints AND story points (numerator = story-point SUM of the ready items, SP ÷ SP); with story points but NO sprints the calculation uses issue counts (ready issues ÷ Average Throughput per period) to avoid mixing units; no story points — issues as well. Optimal range: 2–3 sprints of coverage — below 2 the team risks starving for startable work, above 3 the grooming effort is wasted. The box shows the AVG of the per-period values (control points): sum of Backlog Health at each period end ÷ number of control points in the window.",
  bugflow: "Bug Growth = new vs resolved Defects per 2-week period. When new bugs outpace resolved the defect backlog grows and quality deteriorates. The box shows the average per period for each series (Avg New / Avg Resolved) over the window.",
  // [FIX-A2] Leakage: escape-rate formula (qaSet + prod denominator).
  leakage: "Production Leakage = prod-labelled bugs ÷ (bugs that entered QA + prod-labelled bugs). Bucketed by Created date. Lower is better; high leakage means testing fails to contain defects. The box shows the weighted average = total leaked ÷ total (QA-entered + prod) over the window.",
  // [FIX-A5] Bug Fixing Time Allocation: worklog allocation, not lead time.
  bugfix: "Bug Fixing Time Allocation = Σ(timespent on Bug/Sub-bug) ÷ Σ(timespent on all completed work) × 100% per period. Requires Jira worklog. Healthy: < 20%. Not available when the project does not log work time (timespent fill-rate < 20%).",
  incident: "Incident Frequency = number of production Defects (tagged 'Prod') per 2-week period, stacked by severity (Critical/Major/Minor derived from priority). A rising frequency — especially Critical — indicates production stability is degrading. The box shows the average total incidents per period over the window.",
  qa: "Time in QA = avg(Done − first entry into QA) for Story/Task with a QA transition (Ready for QA / In Testing). Measures how long work sits in the testing phase. HEALTHY < 1 sprint (<14 days). The box shows the weighted average over the window: total days ÷ number of items.",
  // [FIX-A1] Defect Density: mode-dependent base tooltip (the active variant
  // is picked in rcTipFor based on densityMode / SP fill-rate).
  defectdensity: "Defect Density = Story Points of defects ÷ Story Points of completed Story/Task per period. High density = messy logic / rushed coding / high cyclomatic complexity. Lower is better.",
  defectdensity_per_item: "Defect Density = Defects ÷ (Story + Task) per period. Note: story points are not available in this project (or fill-rate < 50%), so the denominator uses issue counts. Lower is better.",
  // [FIX-A4] WIP: point-in-time snapshot (no 'inflow' wording).
  wip: "WIP = number of items in a dev status at each period end (point-in-time snapshot). Target ≤ 1.5 per developer. High WIP → high context switching → slower flow. Lower is better. The box shows the average snapshot WIP per period over the window.",
  bugfix_na: "Not available — the project does not log work time (timespent fill-rate < 20%).",
  floweff: "Flow Efficiency = Active work time ÷ Total elapsed time × 100%. Active = In Progress → Done; Total = Created → Done. Measures what fraction of lead time is actual work vs waiting. Higher is better (e.g. >50% is good, <25% is poor). The box shows the weighted average over the window: total active ÷ total elapsed."
};
// Issue Types offered in the multi-select filter: the canonical five first,
// then every other type actually present in the data (so no item type is
// impossible to select — e.g. Test / Security issue / Epic / Improvement).
var ISSUE_TYPES = (function(){
  var out=['Story','Task','Defect','Sub-bug','Sub-task'], seen={};
  out.forEach(function(t){ seen[t]=1; });
  Object.keys(PM_DATA).forEach(function(mk){
    (PM_DATA[mk]||[]).forEach(function(it){
      var lbl=rcTypeLabel(it.type);
      if(lbl && !seen[lbl]){ seen[lbl]=1; out.push(lbl); }
    });
  });
  return out;
})();
function rcPopulateTypes(){
  var wrap=document.getElementById('rcTypeWrap');
  if(!wrap) return;
  wrap.innerHTML='';
  var defaults=RC_CFG[rcMetric].types||ISSUE_TYPES;
  ISSUE_TYPES.forEach(function(t){
    var lb=document.createElement('label');
    lb.className='inline-flex items-center gap-1 text-xs border rounded px-2 py-1 cursor-pointer';
    var cb=document.createElement('input');
    cb.type='checkbox'; cb.value=t; cb.className='rcTypeCb';
    cb.onchange=rcMarkPending;
    cb.checked = defaults.indexOf(t) >= 0;
    lb.appendChild(cb); lb.appendChild(document.createTextNode(t));
    wrap.appendChild(lb);
  });
}
function rcTypeSelected(){
  var cbs=document.querySelectorAll('#rcTypeWrap .rcTypeCb:checked');
  var set={};
  Array.prototype.forEach.call(cbs,function(cb){ set[cb.value]=1; });
  return set;
}
function rcTipHtml(text){
  return '<span class="tip-wrap" data-align="left">'+
    '<span class="tip-icon" title="">ⓘ</span>'+
    '<span class="tip-box">'+text+'</span></span>';
}
// How the top-right box value is computed (per metric; static semantics).
var RC_TIP_BOX = {
  cycle: 'Box (top-right): weighted average over the window = total days ÷ number of items, respecting all filters.',
  cycletime: 'Box (top-right): weighted average over the window = total days ÷ number of items.',
  lead: 'Box (top-right): weighted average over the window = total days ÷ number of items.',
  qa: 'Box (top-right): weighted average over the window = total days ÷ number of items.',
  bugfix: 'Box (top-right): weighted allocation % over the window = Σ bug timespent ÷ Σ all timespent.',   // [FIX-A5]
  floweff: 'Box (top-right): weighted average = total active days ÷ total elapsed days over the window.',
  wip: 'Box (top-right): average snapshot WIP per period over the window.',   // [FIX-A4]
  throughput: 'Box (top-right): average completed per period over the window.',
  velocity: 'Box (top-right): average completed per period over the window.',
  backlog: 'Box (top-right): AVG of the per-period Backlog Health values (control points) = sprints of ready backlog.',
  rework: 'Box (top-right): weighted average = total reworked ÷ total started over the window.',
  defectdensity: 'Box (top-right): weighted ratio over the window = Σ defect SP ÷ Σ completed Story/Task SP (per_item: #defects ÷ #(Story+Task)).',   // [FIX-A1]
  leakage: 'Box (top-right): weighted average = total leaked ÷ total (QA-entered + prod) over the window.',   // [FIX-A2]
  incident: 'Box (top-right): average total incidents per period over the window.',
  flow: 'Box (top-right): average per period for each series (Avg Opened / Avg Resolved) over the window.',
  bugflow: 'Box (top-right): average per period for each series (Avg New / Avg Resolved) over the window.'
};
// Inclusion conditions ("Counted: …") generated from the current settings.
function rcTipCounted(mk){
  var S=RC_SETTINGS, m=(S.metrics||{})[mk]||{};
  function types(ref){
    if(ref===undefined) ref=m.types;
    if(typeof ref==='string') ref=(S.types||{})[ref]||[];
    return (ref||[]).join(', ')||'—';
  }
  var prod=rcProdLabelEff(String(m.prodLabel||S.prodLabel||'prod'), S);
  if(mk==='defectdensity'){
    // [FIX-A1] Counted text follows the effective density mode.
    var mode=rcDensityMode();
    return mode==='per_sp'
      ? 'Counted: per period — Σ(story points of Bug/Sub-bug, by Created) ÷ Σ(story points of completed Story/Task, by Done).'
      : 'Counted: per period — #defects (Bug/Sub-bug, by Created) ÷ #(Story+Task completed), bucketed by Created/Done.';
  }
  if(mk==='leakage'){
    // [FIX-A2]
    return 'Counted: per period — prod-labelled bugs ÷ (bugs that entered ['+
      ((S.statusSets||{})[m.qaSet||'qaSet']||[]).join(', ')+'] or are prod-labelled), bucketed by Created date.';
  }
  if(m.aggregation==='flow'){
    var ser=(mk==='flow')?'opened = Created, resolved = Resolution date'
                         :'new = Created, resolved = Resolution date';
    return 'Counted: per period, two series for '+types()+' — '+ser+'.';
  }
  var bits=[];
  if(mk==='incident'){
    bits.push(types()+' labeled ['+prod+']');
    bits.push('stacked by severity from priority (Critical/Major/Minor)');
  } else if(mk==='backlog'){
    var denB=(m.denominator||'auto');
    bits.push('ready AT each period end (status ∈ ['+((S.statusSets[(m.membership||{}).set]||[]).join(', ')||'—')+']) ÷ team speed per period ('+(denB==='throughput'?'Throughput':(denB==='velocity_sp'?'Velocity SP':'Velocity SP when sprints+SP, else Throughput (auto)'))+')');
  } else if(mk==='rework'){
    bits.push(types()+' that returned to ['+((S.statusSets[(m.returnTo||{}).set]||[]).join(', ')||'—')+'] after dev start');
  } else if(mk==='bugfix'){
    // [FIX-A5]
    bits.push('Σ(timespent on '+types()+') ÷ Σ(timespent on all completed work) × 100, bucketed by Done date');
  } else {
    bits.push(types());
  }
  return 'Counted: '+bits.join('; ')+'.';
}
// [FIX-A1] Effective Defect Density mode: the explicit setting wins; 'auto'
// picks per_sp when the SP fill-rate of the denominator items (Story/Task
// completed) is ≥ 50%, else per_item.
function rcDensityMode(){
  var m=((rcDraft||RC_SETTINGS).metrics||{}).defectdensity||{};
  var den=(PM_DATA.defectdensity||[]).filter(function(it){ return it.role==='denominator'; });
  var filled=den.filter(function(it){ return (it.sp||0)>0; }).length;
  var rate=den.length? filled/den.length : 0;
  return m.densityMode==='per_item' ? 'per_item'
       : m.densityMode==='per_sp' ? 'per_sp'
       : (den.length && rate>=0.5 ? 'per_sp' : 'per_item');
}
// [FIX-A5] Does the project log work time? (timespent fill-rate ≥ 20% over
// the Bug Fixing items — numerator + denominator roles.)
function rcHasTimespent(){
  var its=PM_DATA.bugfix||[];
  if(!its.length) return false;
  var withTs=0;
  its.forEach(function(it){ if((it.timeSpent||0)>0) withTs++; });
  return withTs/Math.max(1,its.length)>=0.2;
}
// Unified tooltip: interpretation + Formula + Counted + Trend + Box.
function rcTipFor(mk){
  var S=RC_SETTINGS;
  // [FIX-A1] Defect Density: the base text follows the effective mode;
  // [FIX-A5] Bugfix: N/A text when the project has no worklog.
  var base=RC_TIP[mk]||'';
  if(mk==='defectdensity'&&rcDensityMode()==='per_item'){
    base=RC_TIP.defectdensity_per_item||base;
  }
  if(mk==='bugfix'&&rcHasTimespent()===false){
    base=RC_TIP.bugfix_na||base;
  }
  return (base||'')
    +' Formula: '+rcFormulaText(mk, S)+'.'
    +' '+rcTipCounted(mk)
    +' '+rcTrendRule(mk, S)
    +' '+(RC_TIP_BOX[mk]||'');
}
function rcSetTip(){
  var box=document.getElementById('rcTipBox');
  if(box){ box.innerHTML = rcTipHtml(rcTipFor(rcMetric)); }
}
function rcActiveItems(){ return PM_DATA[rcMetric]||[]; }
function rcSetMetric(m){
  rcMetric = m;
  Object.keys(RC_CFG).forEach(function(k){
    var b=document.getElementById('rcM-'+k);
    if(b){ b.classList.toggle('bg-blue-600', m===k); b.classList.toggle('text-white', m===k); }
  });
  rcSetTip();
  rcPopulateDim();
  rcPopulateTypes();
  // The settings panel is per-metric: if it is open, re-render it so it
  // follows the newly selected metric (same behavior as the info tooltip).
  var _sp=document.getElementById('rcSettingsPanel');
  if(_sp && !_sp.classList.contains('hidden')){ rcSettingsRender(); }
  // Default state: keep the calendar aligned with the current metric's
  // default window until the user edits the dates manually.
  rcSyncCalendar();
  rcApply();
}
// ---- Time granularity (Periods select) --------------------------------
// daily | weekly | sprint (2-week bucket; Sprint fallback when Sprints are
// unavailable from Jira) | monthly | quarterly | annual.
var RC_GRAN_LABEL = {
  daily:'Day', weekly:'Week', sprint:'Sprint (2 weeks)',
  monthly:'Month', quarterly:'Quarter', annual:'Year'
};
// Default number of buckets shown when no calendar range is applied:
// Sprint -> last 5 sprints; other granularities -> the last active bucket.
var RC_GRAN_DEFAULT_N = { daily:1, weekly:1, sprint:5, monthly:1, quarterly:1, annual:1 };
// Set to true once the user manually edits the From/To calendar inputs.
var rcCalTouched = false;

function rcPad2(v){ return String(v).padStart(2,'0'); }
function rcDateStr(d){
  return d.getFullYear()+'-'+rcPad2(d.getMonth()+1)+'-'+rcPad2(d.getDate());
}
function rcIsoWeekMonday(d){
  var t=new Date(d); t.setHours(0,0,0,0);
  t.setDate(t.getDate()-((t.getDay()+6)%7)); // Monday of the ISO week
  return t;
}
function rcIsoWeekNum(monday){
  var yr=monday.getFullYear();
  return Math.ceil((((monday-new Date(yr,0,1))/86400000)+1)/7);
}
// Monday that starts the 2-week (sprint) bucket containing d.
// Uses the SAME Thursday-based ISO week number as rcBucketKey so sprint
// boundaries stay consistent across ISO year boundaries (a naive
// Monday-based week number disagrees with ISO near Dec/Jan, which used to
// shift the default window by one sprint and drop the newest bucket's
// items from the chart).
function rcSprintStart(d){
  var mon=rcIsoWeekMonday(d);
  var thu=new Date(mon); thu.setDate(thu.getDate()+3); // Thursday of this ISO week
  var wk=Math.ceil((((thu-new Date(thu.getFullYear(),0,1))/86400000)+1)/7);
  if(wk%2===0) mon.setDate(mon.getDate()-7); // sprint starts on an odd ISO week
  return mon;
}
// Bucket key for a date at the given granularity. Keys sort chronologically.
function rcBucketKey(d, gran){
  var t=new Date(d); t.setHours(0,0,0,0);
  if(gran==='daily') return rcDateStr(t);
  if(gran==='weekly') return rcDateStr(rcIsoWeekMonday(t));
  if(gran==='monthly') return t.getFullYear()+'-'+rcPad2(t.getMonth()+1);
  if(gran==='quarterly') return t.getFullYear()+'-Q'+(Math.floor(t.getMonth()/3)+1);
  if(gran==='annual') return String(t.getFullYear());
  // sprint (default): 2-week ISO bucket (weeks 1-2, 3-4, ...)
  var tmp=new Date(t);
  tmp.setDate(tmp.getDate()+3-((tmp.getDay()+6)%7)); // Thursday of ISO week
  var w1=tmp.getFullYear();
  var wk=Math.ceil((((tmp-new Date(w1,0,1))/86400000)+1)/7);
  var bucket=((wk-1)>>1)*2+1;
  return w1+'-W'+String(bucket).padStart(2,'0')+'-'+String(bucket+1).padStart(2,'0');
}
// First bucket-start date of the bucket containing d.
function rcBucketStart(d, gran){
  var t=new Date(d); t.setHours(0,0,0,0);
  if(gran==='daily') return t;
  if(gran==='weekly') return rcIsoWeekMonday(t);
  if(gran==='sprint') return rcSprintStart(t);
  if(gran==='monthly') return new Date(t.getFullYear(), t.getMonth(), 1);
  if(gran==='quarterly') return new Date(t.getFullYear(), Math.floor(t.getMonth()/3)*3, 1);
  if(gran==='annual') return new Date(t.getFullYear(), 0, 1);
  return rcSprintStart(t);
}
// Generate ALL bucket keys covering [fromD .. toD] at the granularity.
function rcAxisRange(fromD, toD, gran){
  var keys=[], guard=0, cur=rcBucketStart(fromD, gran);
  var step = (gran==='daily')?1:(gran==='weekly')?7:(gran==='sprint')?14
            :(gran==='monthly')?1:(gran==='quarterly')?3:12;
  while(cur<=toD && guard<2000){
    keys.push(rcBucketKey(cur, gran));
    if(gran==='daily'||gran==='weekly'||gran==='sprint') cur.setDate(cur.getDate()+step);
    else if(gran==='annual') cur.setFullYear(cur.getFullYear()+step);
    else cur.setMonth(cur.getMonth()+step);
    guard++;
  }
  return keys;
}
// Legacy 2-week (sprint) bucket key — kept for compatibility.
function rcPeriKey(d){
  return rcBucketKey(d, 'sprint');
}
// End timestamp (last ms) of the bucket with key `key` at granularity
// `gran` — the Backlog Health snapshot control point.
function rcBucketEnd(key, gran){
  var y=parseInt(key.slice(0,4),10);
  if(gran==='daily'){
    var d=new Date(key+'T00:00:00'); d.setDate(d.getDate()+1);
    return d.getTime()-1;
  }
  if(gran==='weekly'){
    // ISO week key: YYYY-Wnn
    var wk=parseInt(key.split('-W')[1],10);
    var mon=rcIsoWeekMonday(new Date(Date.UTC(y,0,4)));
    mon.setUTCDate(mon.getUTCDate()+(wk-1)*7+7);
    return mon.getTime()-1;
  }
  if(gran==='sprint'){
    // sprint key: YYYY-Wnn-mm (two ISO weeks starting at week nn)
    var wk2=parseInt(key.split('-W')[1],10);
    var mon2=rcIsoWeekMonday(new Date(Date.UTC(y,0,4)));
    mon2.setUTCDate(mon2.getUTCDate()+(wk2-1)*7+14);
    return mon2.getTime()-1;
  }
  if(gran==='monthly'){ var m2=new Date(y, parseInt(key.slice(5),10), 1); return m2.getTime()-1; }
  if(gran==='quarterly'){ var q=parseInt(key.slice(6),10); return new Date(y, (q)*3, 1).getTime()-1; }
  if(gran==='annual'){ return new Date(y+1, 0, 1).getTime()-1; }
  return new Date(y, parseInt(key.slice(5),10), 1).getTime()-1;
}
// Default window (From/To dates) for a granularity, anchored at the last
// active date of the current metric's items.
function rcDefaultWindow(gran){
  // Anchor at the last active date of items that pass the metric's DEFAULT
  // type filter AND the currently applied Issue Type selection (so e.g.
  // "Opened vs Resolved" + Defect/Sub-bug filter anchors on the same data as
  // Bug Growth, keeping the two metrics comparable).
  var last=null;
  var cfg=RC_CFG[rcMetric];
  var defTypes=(cfg&&cfg.types)?cfg.types:null;
  var typeSel=rcTypeSelected();
  var dim=document.getElementById('rcDim').value;
  var sel=rcSelected();
  rcActiveItems().forEach(function(it){
    if(defTypes && defTypes.indexOf(rcTypeLabel(it.type))<0) return;
    if(typeSel && !typeSel[rcTypeLabel(it.type)]) return;
    if(!rcDimMatch(it, dim, sel)) return;
    var t=new Date(it.dev_start);
    if(!isNaN(t) && (!last || t>last)) last=t;
  });
  if(!last || isNaN(last)) return null;
  last.setHours(0,0,0,0);
  var from, to;
  if(gran==='daily'){ from=new Date(last); to=new Date(last); }
  else if(gran==='weekly'){
    from=rcIsoWeekMonday(last); to=new Date(from); to.setDate(to.getDate()+6);
  }
  else if(gran==='monthly'){
    from=new Date(last.getFullYear(), last.getMonth(), 1);
    to=new Date(last.getFullYear(), last.getMonth()+1, 0);
  }
  else if(gran==='quarterly'){
    var qm=Math.floor(last.getMonth()/3)*3;
    from=new Date(last.getFullYear(), qm, 1);
    to=new Date(last.getFullYear(), qm+3, 0);
  }
  else if(gran==='annual'){
    from=new Date(last.getFullYear(),0,1); to=new Date(last.getFullYear(),11,31);
  }
  else { // sprint: last 5 two-week buckets incl. the active one
    var s=rcSprintStart(last);
    from=new Date(s); from.setDate(from.getDate()-56);
    to=new Date(s); to.setDate(to.getDate()+13);
  }
  return {from:from, to:to};
}
// Pre-fill the calendar inputs with the default window while the user has
// not manually edited them (default state per spec).
function rcSyncCalendar(){
  if(rcCalTouched) return;
  var gran=document.getElementById('rcPeriods').value;
  var w=rcDefaultWindow(gran);
  if(w){
    document.getElementById('rcFrom').value=rcDateStr(w.from);
    document.getElementById('rcTo').value=rcDateStr(w.to);
  }
}
function rcPeriodsChanged(){
  // Keep the calendar in sync with the default window of the selected
  // granularity until the user edits the dates manually. The chart is NOT
  // recalculated here — the user confirms the change with Apply (the same
  // applies to the Dimensions select and the multi-select checkboxes).
  rcSyncCalendar();
  rcMarkPending();
}
// Pending-change indicator: highlight Apply until the user confirms.
function rcMarkPending(){
  var b=document.getElementById('rcApplyBtn');
  if(b){ b.classList.add('ring-2','ring-blue-400'); }
}
function rcClearPending(){
  var b=document.getElementById('rcApplyBtn');
  if(b){ b.classList.remove('ring-2','ring-blue-400'); }
}
function rcLinearTrend(points){
  var n=points.length; if(n<2) return null;
  var sx=0,sy=0,sxy=0,sxx=0;
  for(var i=0;i<n;i++){ var x=i,y=points[i]; sx+=x; sy+=y; sxy+=x*y; sxx+=x*x; }
  var denom=n*sxx-sx*sx; if(!denom) return null;
  var slope=(n*sxy-sx*sy)/denom;
  return {slope:slope, line:points.map(function(_,i){ return Math.max(0, sy/n + slope*(i-(n-1)/2)); })};
}
// An item's team(s), resolved LIVE from the widget-level teamConfig (so a
// source change in the settings takes effect immediately):
//   source=none   -> ["Team is not defined"]
//   source=field  -> the selected field's value (from `fieldvals` in the
//                    raw records, parsed from the issue document text)
//   source=labels -> EVERY selected label present on the issue
//                    (multi-membership); none matched -> undefined group.
// An item's team(s), resolved LIVE from the widget-level teamConfig (so a
// source change in the settings takes effect immediately):
//   source=none   -> ["Team is not defined"]
//   source=field  -> the selected field's value (from `fieldvals` in the
//                    raw records, parsed from the issue document text)
//   source=labels -> EVERY selected label present on the issue
//                    (multi-membership); none matched -> undefined group.
function rcItemTeams(it){
  var tc=(rcDraft||RC_SETTINGS).teamConfig||{}, src=tc.source||'none';
  var UNDEF='Team is not defined';
  if(src==='labels'){
    var sel={};
    (tc.labels||[]).forEach(function(l){ sel[String(l).trim().toLowerCase()]=1; });
    var out=[];
    String(it.labels||'').split(',').forEach(function(l){
      var v=l.trim();
      if(v&&sel[v.toLowerCase()]) out.push(v);
    });
    return out.length?out:[UNDEF];
  }
  if(src==='field'&&tc.fieldName){
    var v=(it.fieldvals||{})[tc.fieldName];
    return v?[String(v)]:[UNDEF];
  }
  return [UNDEF];
}
// Dimension value field for an item: `component` maps to the record's
// `team` field (the issue's first component — the pre-settings dim).
function rcDimField(dim){
  return dim==='component' ? 'team' : dim;
}
function rcDimValues(dim){
  var seen={}, out=[];
  rcActiveItems().forEach(function(it){
    if(dim==='team'){
      rcItemTeams(it).forEach(function(v){
        if(!seen[v]){ seen[v]=1; out.push(v); }
      });
      return;
    }
    var v=it[rcDimField(dim)]||'';
    if(!seen[v]){ seen[v]=1; out.push(v); }
  });
  return out.sort();
}
function rcPopulateDim(){
  var dim=document.getElementById('rcDim').value;
  var wrap=document.getElementById('rcDimList');
  if(dim==='project'){
    wrap.innerHTML='<span class="text-xs text-gray-500">Project: single value — all data</span>';
    return;
  }
  if(dim==='team' &&
     ((RC_SETTINGS.teamConfig||{}).source||'none')==='none'){
    // Default message when the Team source is not configured.
    wrap.innerHTML='<span class="text-xs text-gray-500">Team is not defined — configure the source in widget settings (gear icon → Widget settings → Team dimension).</span>';
    return;
  }
  var vals=rcDimValues(dim);
  wrap.innerHTML='';
  vals.forEach(function(v){
    var lb=document.createElement('label');
    lb.className='inline-flex items-center gap-1 text-xs border rounded px-2 py-1 cursor-pointer';
    var cb=document.createElement('input');
    cb.type='checkbox'; cb.value=v; cb.className='rcDimCb'; cb.checked=true;
    cb.onchange=rcMarkPending;
    lb.appendChild(cb); lb.appendChild(document.createTextNode(v));
    wrap.appendChild(lb);
  });
}
// Does the item pass the dimension filter? Team is multi-membership:
// the item matches if ANY of its teams is selected.
function rcDimMatch(it, dim, sel){
  if(!sel) return true;
  if(dim==='team'){
    return rcItemTeams(it).some(function(v){ return sel[v]; });
  }
  return !!sel[it[rcDimField(dim)]];
}
function rcSelected(){
  var dim=document.getElementById('rcDim').value;
  if(dim==='project') return null; // no filtering (all)
  var cbs=document.querySelectorAll('#rcDimList .rcDimCb:checked');
  var set={};
  Array.prototype.forEach.call(cbs,function(cb){ set[cb.value]=1; });
  return set;
}
function rcAggValue(cfg, a){
  if(a===null||a===undefined) return null;
  if(cfg.rateMode==='spDensity'){
    // [FIX-A1] Defect Density: raw ratio (SP of defects ÷ SP completed, or
    // #defects ÷ #(Story+Task)) — NOT a percentage.
    return a.total ? (a.n/a.total) : null;
  }
  if(cfg.rateMode==='roles'){
    // [FIX-A2] Leakage escape rate, %.
    return a.total ? (a.n/a.total*100) : null;
  }
  if(cfg.aggregation==='allocation'){
    // [FIX-A5] timespent allocation, %.
    return a.total ? (a.n/a.total*100) : null;
  }
  if(cfg.aggregation==='rate') return a.total ? (a.n/a.total*100) : null;
  if(cfg.aggregation==='sum')  return a;
  if(cfg.aggregation==='count') return a;
  // avg
  return a.reduce(function(s,v){return s+v;},0)/a.length;
}
function rcApply(){
  // Timeline selection: custom From/To calendar range, else the last N buckets
  // of the selected granularity (Sprint -> last 5, others -> last active one).
  var fromInput=document.getElementById('rcFrom').value;
  var toInput=document.getElementById('rcTo').value;
  var hasCustom = fromInput || toInput;
  var from=null, to=null;
  if(fromInput&&toInput){ from=new Date(fromInput+'T00:00:00'); to=new Date(toInput+'T23:59:59'); }
  else if(fromInput){ from=new Date(fromInput+'T00:00:00'); to=null; }
  else if(toInput){ from=null; to=new Date(toInput+'T23:59:59'); }
  var gran=document.getElementById('rcPeriods').value;
  var dim=document.getElementById('rcDim').value;
  var sel=rcSelected();
  var typeSel=rcTypeSelected();
  var cfg=RC_CFG[rcMetric];
  var items=rcActiveItems();
  var isCoverage = cfg.aggregation==='coverage';
  var isWipSnap = cfg.aggregation==='wipSnapshot';   // [FIX-A4]
  var isAlloc = cfg.aggregation==='allocation';      // [FIX-A5] timespent share
  var agg={}, seriesAgg=null, groupAgg=null;
  var isFlow = cfg.aggregation==='flow';
  var isGrouped = cfg.aggregation==='grouped';
  if(isFlow){ seriesAgg={}; }
  if(isGrouped){ groupAgg={}; }
  // [FIX-A5] Bug Fixing Time Allocation: N/A when the timespent fill-rate
  // is below 20% (the project does not log work time).
  var RC_HAS_TIMESPENT = (function(){
    var its=items||[];
    if(!its.length) return false;
    var withTs=0; its.forEach(function(it){ if((it.timeSpent||0)>0) withTs++; });
    return withTs/Math.max(1,its.length) >= 0.2;
  })();
  // [FIX-A1] Defect Density effective mode + SP fill-rate (denominator
  // role = Story/Task items in the window).
  var ddMode=null, ddFillRate=0, ddFilled=0, ddTotal=0;
  var isDensity = rcMetric==='defectdensity' && cfg.rateMode==='spDensity';
  if(isDensity){
    var mDD=((rcDraft||RC_SETTINGS).metrics||{})[rcMetric]||{};
    var denItems=items.filter(function(it){ return it.role==='denominator'; });
    ddTotal=denItems.length;
    ddFilled=denItems.filter(function(it){ return (it.sp||0)>0; }).length;
    ddFillRate=ddTotal? ddFilled/ddTotal : 0;
    ddMode = mDD.densityMode==='per_item' ? 'per_item'
           : mDD.densityMode==='per_sp' ? 'per_sp'
           : (ddTotal && ddFilled/ddTotal>=0.5 ? 'per_sp' : 'per_item');
  }
  // Backlog Health (coverage): ready intervals + team-speed denominators.
  var covReady=[];   // {rf, rl} ready intervals of the filtered items
  var covDen={};     // per-period team speed: {sp: sum SP completed, n: count}
  var wipItems=[];   // [FIX-A4] filtered WIP snapshot items
  var usedKeys={};  // unique issue keys participating in this calculation
  items.forEach(function(it){
    if(!rcDimMatch(it, dim, sel)) return;
    if(typeSel && !typeSel[rcTypeLabel(it.type)]) return;
    // [FIX-A4] WIP snapshot: the calendar range only picks WHICH bucket-ends
    // are shown — the item filter for a bucket end is enterDev ≤ endP <
    // leaveDev (no from/to date filter, so long-open items still count).
    if(cfg.aggregation==='wipSnapshot'){ wipItems.push(it); return; }
    var t=new Date(it.dev_start);
    if(from&&t<from) return;
    if(to&&t>to) return;
    usedKeys[it.key]=1;
    var key=rcBucketKey(t, gran);
    if(isCoverage){
      // Backlog Health (coverage): snapshot semantics. The item is "ready"
      // at a period end P when readyFrom <= P < readyLeft (or never left).
      // Aggregation happens AFTER the periods are known (see below) — here
      // we only collect the item's ready interval (and its story points for
      // the SP-sum numerator of the Velocity (SP) denominator).
      var rf=(it.readyFrom!==undefined&&it.readyFrom!==null)?it.readyFrom:t.getTime();
      var rl=(it.readyLeft===null||it.readyLeft===undefined)?null:it.readyLeft;
      covReady.push({rf:rf, rl:rl, sp:(it.sp!==undefined&&it.sp!==null)?it.sp:0});
      return;
    }
    if(isFlow){
      var s=it.series||'opened';
      if(!seriesAgg[s]) seriesAgg[s]={};
      if(!seriesAgg[s][key]) seriesAgg[s][key]=0;
      seriesAgg[s][key]++;
      return;
    }
    if(isGrouped){
      var g=it[cfg.field]||'Other';
      if(!groupAgg[key]) groupAgg[key]={};
      if(!groupAgg[key][g]) groupAgg[key][g]=0;
      groupAgg[key][g]++;
      return;
    }
    if(cfg.rateMode==='spDensity'){
      // [FIX-A1] Defect Density (role-based): per_sp weights by story
      // points, per_item by issue count; value = n ÷ total (raw ratio).
      if(!agg[key]) agg[key]={n:0,total:0};
      if(it.role==='numerator')   agg[key].n     += (ddMode==='per_sp' ? (it.sp||0) : 1);
      if(it.role==='denominator') agg[key].total += (ddMode==='per_sp' ? (it.sp||0) : 1);
      return;
    }
    if(cfg.rateMode==='roles'){
      // [FIX-A2] Leakage: numerator = prod-labelled bugs, denominator =
      // bugs entered QA or prod-labelled; value = n/total×100 (%).
      if(!agg[key]) agg[key]={n:0,total:0};
      if(it.role==='numerator') agg[key].n++;
      if(it.role==='denominator') agg[key].total++;
      return;
    }
    if(isAlloc){
      // [FIX-A5] Bug Fixing Time Allocation: Σ(timespent bugs) ÷
      // Σ(timespent all completed work) × 100 per bucket.
      if(!agg[key]) agg[key]={n:0,total:0};
      if(it.role==='numerator')   agg[key].n     += (it.timeSpent||0);
      if(it.role==='denominator') agg[key].total += (it.timeSpent||0);
      return;
    }
    if(cfg.aggregation==='rate'){
      if(!agg[key]) agg[key]={n:0,total:0};
      agg[key].total++;
      if(it[cfg.field]) agg[key].n++;
    } else if(cfg.aggregation==='avg'){
      if(!agg[key]) agg[key]=[];
      agg[key].push(it[cfg.field]);
    } else if(cfg.aggregation==='sum'){
      if(!agg[key]) agg[key]=0;
      agg[key]+=it[cfg.field];
    } else { // count
      if(!agg[key]) agg[key]=0;
      agg[key]++;
    }
  });
  // ---- Backlog Health (coverage): team-speed denominator ------------------
  // BH(P) = ready(P) ÷ avg team speed per period, where
  //   ready(P) = # items ready at the period end P (snapshot), and
  //   avg team speed = Average Velocity (story points) per period — used
  //   ONLY when the project has sprints AND story points (numerator = SP
  //   sum of the ready items); fallback: Average Throughput (issues) per
  //   period when the project has no sprints or no story points
  //   (denominator: auto|velocity_sp|throughput).
  if(isCoverage){
    // denominator=auto: Average Velocity (story points) per period is used
    // ONLY when the project has sprints AND story points — the numerator is
    // then the SP SUM of the ready items (SP ÷ SP, consistent units). When
    // the project has story points but NO sprints (or no SP at all), the
    // calculation falls back to issue counts (ready issues ÷ avg
    // Throughput issues per period) to avoid mixing units.
    var hasSP=items.some(function(it){ return it.sp>0; });
    covUseSP = cfg.denominator==='velocity_sp' ? true
             : cfg.denominator==='throughput' ? false
             : (hasSP && (typeof RC_HAS_SPRINTS==='undefined' ? true : !!RC_HAS_SPRINTS));
    // Per-period team speed from the velocity items (SP) or throughput count.
    (PM_DATA.velocity||[]).forEach(function(v){
      var t=new Date(v.dev_start);
      if(isNaN(t)) return;
      if(from&&t<from) return;
      if(to&&t>to) return;
      if(!rcDimMatch(v, dim, sel)) return;
      if(typeSel && !typeSel[rcTypeLabel(v.type)]) return;
      var k=rcBucketKey(t, gran);
      if(!covDen[k]) covDen[k]={spSum:0,n:0};
      covDen[k].n++;
      covDen[k].spSum+=(v.sp||0);
    });
  }
  // [FIX-A4] Last-N bucket keys ENDING at the bucket containing lastD —
  // the WIP snapshot axis (periods without completions still appear).
  function rcLastBuckets(lastD, n){
    var keys=[], guard=0;
    var cur=rcBucketStart(lastD, gran);
    var step=(gran==='daily')?1:(gran==='weekly')?7:(gran==='sprint')?14
            :(gran==='monthly')?1:(gran==='quarterly')?3:12;
    while(keys.length<n && guard<2000){
      keys.push(rcBucketKey(cur, gran));
      if(gran==='daily'||gran==='weekly'||gran==='sprint') cur.setDate(cur.getDate()-step);
      else if(gran==='annual') cur.setFullYear(cur.getFullYear()-step);
      else cur.setMonth(cur.getMonth()-step);
      guard++;
    }
    return keys.reverse();
  }
  var periods;
  if(isCoverage){
    // Backlog Health control points = periods where the team completed
    // work (velocity/throughput), so the denominator is defined.
    periods=Object.keys(covDen);
  }
  else if(isWipSnap){
    // [FIX-A4] Bucket-ends from the AXIS (rcAxisRange / last-N buckets),
    // NOT from the items — periods without completions still get a point.
    periods=null;
  }
  else if(isFlow){ periods=[].concat.apply([],Object.keys(seriesAgg).map(function(s){return Object.keys(seriesAgg[s]);})); }
  else if(isGrouped){ periods=Object.keys(groupAgg); }
  else { periods=Object.keys(agg); }
  if(periods!==null) periods=Array.from(new Set(periods)).sort();
  var granLabel = RC_GRAN_LABEL[gran] || 'Sprint (2 weeks)';
  var rangeUsed = false;
  if(hasCustom){
    // Calendar range applied: show a bar for EVERY bucket of the selected
    // granularity inside the range (X-axis = bucket timestamps).
    rangeUsed = true;
    var rangeFrom = from || null, rangeTo = to || null;
    if(!rangeFrom || !rangeTo){
      // Derive the missing side from the filtered items' date span.
      var minD=null, maxD=null;
      items.forEach(function(it){
        var t=new Date(it.dev_start);
        if(isNaN(t)) return;
        if(!rcDimMatch(it, dim, sel)) return;
        if(typeSel && !typeSel[rcTypeLabel(it.type)]) return;
        if(!minD||t<minD) minD=t;
        if(!maxD||t>maxD) maxD=t;
      });
      if(!rangeFrom && minD){ rangeFrom=rcBucketStart(minD, gran); }
      if(!rangeTo && maxD){ rangeTo=maxD; }
    }
    if(rangeFrom && rangeTo){
      periods = rcAxisRange(rangeFrom, rangeTo, gran);
    }
  } else if(periods===null){
    // [FIX-A4] WIP snapshot, no calendar: the last N buckets ending at the
    // bucket containing the latest WIP activity (enterDev or an open item's
    // +∞ — anchored at enterDev, the last time the WIP population changed).
    var lastWip=null;
    wipItems.forEach(function(it){
      var t=new Date(it.dev_start);
      if(!isNaN(t)&&(!lastWip||t>lastWip)) lastWip=t;
    });
    periods = lastWip ? rcLastBuckets(lastWip, RC_GRAN_DEFAULT_N[gran]||5) : [];
  } else {
    // No calendar: Sprint -> last 5 sprints; other granularities -> the last
    // active bucket (day / week / month / quarter / year).
    periods = periods.slice(-(RC_GRAN_DEFAULT_N[gran] || 5));
  }
  // ---- Backlog Health (coverage): per-period values -----------------------
  // BH(P) = ready(P) ÷ avg team speed per period:
  //   ready(P)  = # items ready AT the period end P (snapshot from the
  //               readyFrom/readyLeft intervals) — or their STORY POINT SUM
  //               when the Velocity (SP) denominator is active, so the
  //               units stay consistent (SP ÷ SP);
  //   team speed = Average Velocity in story points per period (only when
  //               the project has sprints AND story points) or Average
  //               Throughput (issues) per period otherwise (incl. the
  //               story-points-but-no-sprints case — no mixed units).
  // The box shows the AVG of the per-period BH values (control points).
  var covVals=null, covDenLabel='';
  if(isCoverage){
    covVals = periods.map(function(p){
      // Period end timestamp for the snapshot.
      var pe=rcBucketEnd(p, gran);
      var ready=0, readySP=0;
      covReady.forEach(function(iv){
        if(iv.rf<=pe && (iv.rl===null||iv.rl===undefined||iv.rl>pe)){
          ready++; readySP+=(iv.sp||0);
        }
      });
      var d=covDen[p]||{};
      var num   = covUseSP ? readySP : ready;
      var speed = covUseSP ? (d.spSum||0) : (d.n||0);
      if(!speed) return null;
      return num/speed;
    });
    covDenLabel = covUseSP ? 'avg Velocity (SP)/period' : 'avg Throughput (issues)/period';
  }
  // ---- WIP (snapshot): per-period values ----------------------------------
  // [FIX-A4] wip(P) = |{ item : enterDev ≤ endOf(P) < leaveDev }| — a
  // point-in-time count at each bucket end (leaveDev=null => +∞). The
  // issues table lists every item that was in WIP at ≥1 bucket end.
  var wipVals=null;
  if(isWipSnap){
    wipVals = periods.map(function(p){
      var endP=rcBucketEnd(p, gran);
      var cnt=0;
      wipItems.forEach(function(it){
        var eD=it.enterDev;
        if(eD===null||eD===undefined||eD>endP) return;
        if(it.leaveDev!==null&&it.leaveDev!==undefined&&it.leaveDev<=endP) return;
        usedKeys[it.key]=1;
        cnt++;
      });
      return cnt;
    });
  }
  // Resolve flow series keys/labels once (used by both the average box and the
  // flow chart branch). Flow series may be opened/resolved (Opened vs Resolved)
  // or new/resolved (Bug Growth).
  var sKeys=Object.keys(seriesAgg||{});
  var openKey = sKeys.indexOf('opened')>=0 ? 'opened'
              : (sKeys.indexOf('new')>=0 ? 'new' : (sKeys[0]||'opened'));
  var resolKey = sKeys.indexOf('resolved')>=0 ? 'resolved'
               : (sKeys.filter(function(k){ return k!==openKey; })[0] || null);
  var openLabel = openKey==='new' ? 'New' : (openKey==='opened' ? 'Opened' : openKey);
  var resolLabel = resolKey==='resolved' ? 'Resolved' : (resolKey||'Resolved');
  // Weighted average over the selected window (top-right box).
  // avg-days: sum(days)/count(items); rate: total n / total total;
  // count: total per period / #periods; grouped: total per period / #periods;
  // flow: avg per period for each series (Opened/Resolved or New/Resolved).
  var avgEl=document.getElementById('rcAvgBox');
  function rcFmtAvg(v, unit){ return (Math.round(v*10)/10)+unit; }
  if(avgEl){
    var avgText='';
    if(isCoverage){
      // AVG of the per-period Backlog Health values (control points):
      // sum of BH at each period end ÷ number of control points.
      var defined=covVals.filter(function(v){ return v!==null; });
      avgText = defined.length
        ? 'Avg: '+rcFmtAvg(defined.reduce(function(a,b){return a+b;},0)/defined.length,'')+' sprints'
        : 'Avg: n/a';
    } else if(isFlow){
      var aSum=0,rSum=0;
      periods.forEach(function(p){ aSum+=(seriesAgg[openKey]?seriesAgg[openKey][p]||0:0); rSum+=(seriesAgg[resolKey]?seriesAgg[resolKey][p]||0:0); });
      avgText = periods.length
        ? 'Avg '+openLabel+': '+rcFmtAvg(aSum/periods.length,'')+' · Avg '+resolLabel+': '+rcFmtAvg(rSum/periods.length,'')
        : 'Avg: n/a';
    } else if(isGrouped){
      var totalSum=0; periods.forEach(function(p){ var s=0; Object.keys(groupAgg[p]||{}).forEach(function(g){ s+=groupAgg[p][g]; }); totalSum+=s; });
      avgText = periods.length ? 'Avg: '+rcFmtAvg(totalSum/periods.length,'')+'/period' : 'Avg: n/a';
    } else if(isWipSnap){
      // [FIX-A4] Box = average snapshot WIP per period over the window.
      var wipSum=0; wipVals.forEach(function(v){ wipSum+=v; });
      avgText = periods.length ? 'Avg: '+rcFmtAvg(wipSum/periods.length,'')+'/period' : 'Avg: n/a';
    } else if(cfg.rateMode==='spDensity'){
      // [FIX-A1] Defect Density box: weighted ratio over the window.
      var dn2=0,dt2=0; periods.forEach(function(p){ dn2+=(agg[p]&&agg[p].n)||0; dt2+=(agg[p]&&agg[p].total)||0; });
      avgText = dt2 ? 'Avg: '+rcFmtAvg(dn2/dt2,'') : 'Avg: n/a';
    } else if(cfg.rateMode==='roles'||cfg.aggregation==='allocation'){
      var rn2=0,rt2=0; periods.forEach(function(p){ rn2+=(agg[p]&&agg[p].n)||0; rt2+=(agg[p]&&agg[p].total)||0; });
      avgText = rt2 ? 'Avg: '+rcFmtAvg(rn2/rt2*100,'%') : 'Avg: n/a';
    } else if(cfg.aggregation==='rate'){
      var rn=0,rt=0; periods.forEach(function(p){ rn+=(agg[p]&&agg[p].n)||0; rt+=(agg[p]&&agg[p].total)||0; });
      avgText = rt ? 'Avg: '+rcFmtAvg(rn/rt*100,'%') : 'Avg: n/a';
    } else if(cfg.aggregation==='avg'){
      var rn=0,rt=0; periods.forEach(function(p){ rn+=(agg[p]&&agg[p].n)||0; rt+=(agg[p]&&agg[p].total)||0; });
      avgText = rt ? 'Avg: '+rcFmtAvg(rn/rt*100,'%') : 'Avg: n/a';
    } else if(cfg.aggregation==='avg'){
      var allVals=[]; periods.forEach(function(p){ (agg[p]||[]).forEach(function(v){ allVals.push(v); }); });
      var sumVals=allVals.reduce(function(a,b){return a+b;},0);
      // Unit is per-metric: ' days' for time metrics, '%' for Flow Efficiency.
      var avgUnit = cfg.avg_unit !== undefined && cfg.avg_unit !== null ? cfg.avg_unit : ' days';
      avgText = allVals.length ? 'Avg: '+rcFmtAvg(sumVals/allVals.length, avgUnit) : 'Avg: n/a';
    } else { // count / sum
      var cntVals=0; periods.forEach(function(p){ cntVals+=(agg[p]||0); });
      avgText = periods.length ? 'Avg: '+rcFmtAvg(cntVals/periods.length,'')+'/period' : 'Avg: n/a';
    }
    avgEl.textContent = avgText;
    avgEl.classList.toggle('hidden', avgText.indexOf('n/a')>=0);
  }
  var labels=periods;
  var datasets=[], trend=null;
  if(isFlow){
    // Guard both series lookups: a window may contain only one series (or
    // none after type/dimension filtering) — missing series render as 0.
    var openedVals=periods.map(function(p){return (seriesAgg[openKey]&&seriesAgg[openKey][p])||0;});
    var resolvedVals=periods.map(function(p){return (seriesAgg[resolKey]&&seriesAgg[resolKey][p])||0;});
    // Single trend line: linear trend of the opened/resolved ratio (right axis).
    var ratio=periods.map(function(_,i){ return resolvedVals[i] ? openedVals[i]/resolvedVals[i] : 0; });
    var ratioTrend=rcLinearTrend(ratio);
    datasets=[
      {type:'bar', label:openLabel, data:openedVals,
       backgroundColor:'rgba(37,99,235,0.6)', borderColor:'#2563eb', borderWidth:1},
      {type:'bar', label:resolLabel, data:resolvedVals,
       backgroundColor:'rgba(16,185,129,0.6)', borderColor:'#10b981', borderWidth:1}
    ];
    if(ratioTrend){ datasets.push({type:'line', label:'Trend', data:ratioTrend.line, borderColor:'#ef4444',
      borderDash:[6,4], fill:false, tension:0, pointRadius:0, borderWidth:2, yAxisID:'yRatio'}); }
  } else if(isGrouped){
    // Stacked bars: one dataset per group (severity), counted per period.
    var groups = cfg.groups || ['Critical','Major','Minor'];
    var gcolors = cfg.colors || {};
    groups.forEach(function(g){
      var vals = periods.map(function(p){ return (groupAgg[p]&&groupAgg[p][g])||0; });
      datasets.push({type:'bar', label:g, data:vals,
        backgroundColor:(gcolors[g]||'#94a3b8')+'cc', borderColor:gcolors[g]||'#94a3b8',
        borderWidth:1, stack:'sev'});
    });
    // Total per period for the conclusion/trend.
    var totals = periods.map(function(p){ var s=0; groups.forEach(function(g){ s+=(groupAgg[p]&&groupAgg[p][g])||0; }); return s; });
    trend = rcLinearTrend(totals);
    if(trend){ datasets.push({type:'line', label:'Trend', data:trend.line, borderColor:'#ef4444',
      borderDash:[6,4], fill:false, tension:0, pointRadius:0, borderWidth:2}); }
  } else if(isCoverage){
    // Backlog Health (coverage): bar per control point + healthy band
    // reference lines (2–3 sprints of ready backlog by default).
    var mS=((rcDraft||RC_SETTINGS).metrics||{})[rcMetric]||{};
    var tMin=(mS.targetMin!==undefined&&mS.targetMin!==null)?mS.targetMin:2;
    var tMax=(mS.targetMax!==undefined&&mS.targetMax!==null)?mS.targetMax:3;
    var bhVals=covVals.map(function(v){ return v===null?0:Math.round(v*100)/100; });
    trend=rcLinearTrend(bhVals);
    datasets=[
      {type:'bar', label:cfg.label, data:bhVals,
       backgroundColor:cfg.color+'99', borderColor:cfg.color, borderWidth:1},
      {type:'line', label:'Healthy max ('+tMax+')', data:periods.map(function(){return tMax;}),
       borderColor:'#f59e0b', borderDash:[4,4], fill:false, pointRadius:0, borderWidth:1},
      {type:'line', label:'Min coverage ('+tMin+')', data:periods.map(function(){return tMin;}),
       borderColor:'#ef4444', borderDash:[6,4], fill:false, pointRadius:0, borderWidth:1}
    ];
    if(trend){ datasets.push({type:'line', label:'Trend', data:trend.line, borderColor:'#ef4444',
      borderDash:[6,4], fill:false, tension:0, pointRadius:0, borderWidth:2}); }
  } else if(isWipSnap){
    // [FIX-A4] WIP snapshot: one bar per bucket end (point-in-time count).
    trend=rcLinearTrend(wipVals);
    datasets=[
      {type:'bar', label:cfg.label, data:wipVals,
       backgroundColor:cfg.color+'99', borderColor:cfg.color, borderWidth:1}
    ];
    if(trend){ datasets.push({type:'line', label:'Trend', data:trend.line, borderColor:'#ef4444',
      borderDash:[6,4], fill:false, tension:0, pointRadius:0, borderWidth:2}); }
  } else if(cfg.requires==='timeSpent' && !RC_HAS_TIMESPENT){
    // [FIX-A5] Bug Fixing Time Allocation without worklog: render an empty
    // greyed-out chart (the metric stays in the list; the conclusion line
    // below shows the N/A reason).
    trend=null;
    datasets=[{type:'bar', label:cfg.label, data:periods.map(function(){return 0;}),
      backgroundColor:'rgba(148,163,184,0.25)', borderColor:'#94a3b8', borderWidth:1}];
  } else {
    var values=periods.map(function(p){ return rcAggValue(cfg, agg[p]); });
    trend=rcLinearTrend(values.map(function(v){ return v===null?0:v; }));
    datasets=[
      {type:'bar', label:cfg.label, data:values,
       backgroundColor:cfg.color+'99', borderColor:cfg.color, borderWidth:1}
    ];
    if(trend){ datasets.push({type:'line', label:'Trend', data:trend.line, borderColor:'#ef4444',
      borderDash:[6,4], fill:false, tension:0, pointRadius:0, borderWidth:2}); }
  }
  // Conclusion — single-series: trend of the value itself.
  // Flow (Opened vs Resolved): trend of the net balance (resolved - opened).
  // A rising balance means resolved is catching up with opened => improving.
  // Backlog Health (coverage): BAND rule — value in [targetMin..targetMax]
  // sprints of coverage is healthy; below = under-stocked, above = over-stocked.
  // Flow (Opened vs Resolved): trend of the net balance (resolved - opened).
  // A rising balance means resolved is catching up with opened => improving.
  var conclEl=document.getElementById('rcConclusion');
  var thr=cfg.threshold||0.05;
  if(cfg.requires==='timeSpent' && !RC_HAS_TIMESPENT){
    // [FIX-A5] N/A: the project does not log work time.
    conclEl.textContent='ⓘ N/A — the project does not log work time (timespent fill-rate < 20%).';
  } else if(isFlow && openedVals.length>1){
    var balance=openedVals.map(function(v,i){ return resolvedVals[i]-v; });
    var balTrend=rcLinearTrend(balance);
    if(balTrend && balTrend.slope!==null){
      var c = balTrend.slope > thr ? '🟢 Improving' : (balTrend.slope < -thr ? '🔴 Degrading' : '🟡 Stable');
      conclEl.textContent = c;
    } else { conclEl.textContent = ''; }
  } else if(isCoverage){
    // Band conclusion on the LAST control point's value.
    var lastV=covVals.length?covVals[covVals.length-1]:null;
    if(lastV===null||lastV===undefined){
      conclEl.textContent='';
    } else if(lastV>=tMin&&lastV<=tMax){
      conclEl.textContent='🟢 Healthy coverage ('+(Math.round(lastV*10)/10)+' sprints of ready work)';
    } else if(lastV<tMin){
      conclEl.textContent='🔴 Under-stocked ('+(Math.round(lastV*10)/10)+' sprints of ready work — starvation risk)';
    } else {
      conclEl.textContent='🟡 Over-stocked ('+(Math.round(lastV*10)/10)+' sprints of ready work — grooming waste)';
    }
  } else if(!isFlow && trend && trend.slope!==null){
    // Trend direction is a semantic property of the metric DEFINITION
    // (which slope direction means "Improving") — read from the metric
    // definition in the settings (schema), with the display config as a
    // fallback. It is NOT a user-editable setting.
    var up = (((RC_SETTINGS.metrics||{})[rcMetric]||{}).trendDir
              || cfg.trend_dir || 'down') === 'up';
    var slope = trend.slope;
    var c = (up ? (slope > thr ? '🟢 Improving' : (slope < -thr ? '🔴 Degrading' : '🟡 Stable'))
                : (slope < -thr ? '🟢 Improving' : (slope > thr ? '🔴 Degrading' : '🟡 Stable')));
    conclEl.textContent = c;
  } else { conclEl.textContent = ''; }
  var note=document.getElementById('rcAxisNote');
  if(note){
    // Keep the metric's Y-axis description; rebuild the X-axis part
    // dynamically from the selected granularity.
    var baseNote = cfg.axis_note.split(' X-axis:')[0];
    note.textContent = baseNote + ' · X-axis: ' + granLabel + ' buckets' +
      (rangeUsed ? ' (calendar range applied)' :
        (gran==='sprint' ? ' · Default: last 5 sprints with project activity'
                         : ' · Default: last active ' + granLabel.toLowerCase()));
  }
  rcClearPending();
  // Issues table: unique issues that participated in this calculation.
  RC_TABLE.rows=Object.keys(usedKeys);
  RC_TABLE.page=0;
  rcRenderTable();
  if(rcChart){ rcChart.destroy(); }
  var ctx=document.getElementById('rcChart');
  if(!ctx) return;
  var yOpts={title:{display:true,text:cfg.y_axis}, beginAtZero:true};
  if(cfg.y_min!==null&&cfg.y_min!==undefined){ yOpts.suggestedMin=cfg.y_min; }
  if(cfg.y_max!==null&&cfg.y_max!==undefined){ yOpts.suggestedMax=cfg.y_max; }
  var scales={y:yOpts, x:{title:{display:true,text:'Period ('+granLabel+')'}}};
  if(isGrouped){ scales.y.stacked=true; scales.x.stacked=true; }
  if(isFlow){ scales.yRatio={position:'right', title:{display:true,text:'Ratio ('+openLabel+'/'+resolLabel+')'}, beginAtZero:true}; }
  rcChart=new Chart(ctx,{type:'bar',data:{labels:labels,datasets:datasets},
    options:{responsive:true,maintainAspectRatio:false,
      scales:scales,
      plugins:{legend:{position:'bottom'}}}});
}
// ---- Issues table (issues participating in the current calculation) ----
var RC_TABLE = { rows: [], sortKey: 'created', sortDir: -1, page: 0, pageSize: 25 };
function rcEsc(s){
  return String(s===null||s===undefined?'':s)
    .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;');
}
function rcRenderTable(){
  var body=document.getElementById('rcTableBody');
  if(!body) return;
  var D=RC_ISSUE_DIR||{};
  var rows=RC_TABLE.rows.map(function(k){ var r=D[k]||null; if(r){ r.__key=k; } return r; }).filter(Boolean);
  var sk=RC_TABLE.sortKey, sd=RC_TABLE.sortDir;
  rows.sort(function(a,b){
    var va, vb;
    if(sk==='id'){
      // Natural sort: compare the numeric suffix so EPMRLCT-45 < EPMRLCT-1000.
      var na=String(a.__key).match(/^(.*?)(\d+)$/), nb=String(b.__key).match(/^(.*?)(\d+)$/);
      if(na&&nb&&na[1]===nb[1]){ return (parseInt(na[2],10)-parseInt(nb[2],10))*sd; }
      va=a.__key; vb=b.__key;
    }
    else { va=a[sk]; vb=b[sk]; }
    if(sk==='days_in_status'){
      va=(va===null||va===undefined)?-1:va; vb=(vb===null||vb===undefined)?-1:vb;
      return (va-vb)*sd;
    }
    va=String(va===null||va===undefined?'':va);
    vb=String(vb===null||vb===undefined?'':vb);
    var cmp = va<vb ? -1 : (va>vb ? 1 : 0);
    return cmp*sd;
  });
  var totalPages=Math.max(1, Math.ceil(rows.length/RC_TABLE.pageSize));
  if(RC_TABLE.page>=totalPages) RC_TABLE.page=totalPages-1;
  if(RC_TABLE.page<0) RC_TABLE.page=0;
  var page=rows.slice(RC_TABLE.page*RC_TABLE.pageSize, (RC_TABLE.page+1)*RC_TABLE.pageSize);
  var html='';
  page.forEach(function(r){
    html+='<tr class="border-t hover:bg-gray-50">'+
      '<td class="py-1 px-2"><a href="'+rcEsc(r.url)+'" target="_blank" class="text-blue-600 hover:underline">'+rcEsc(r.__key)+'</a></td>'+
      '<td class="py-1.5 px-2">'+rcEsc(r.type)+'</td>'+
      '<td class="py-1.5 px-2">'+rcEsc(r.summary)+'</td>'+
      '<td class="py-1.5 px-2">'+rcEsc(r.status)+'</td>'+
      '<td class="py-1.5 px-2">'+rcEsc(r.created)+'</td>'+
      '<td class="py-1.5 px-2">'+rcEsc(r.updated)+'</td>'+
      '<td class="py-1.5 px-2">'+(r.days_in_status===null||r.days_in_status===undefined?'—':rcEsc(r.days_in_status))+'</td>'+
      '</tr>';
  });
  body.innerHTML=html;
  var info=document.getElementById('rcPageInfo');
  if(info){ info.textContent = rows.length ? ('Showing '+(RC_TABLE.page*RC_TABLE.pageSize+1)+'-'+Math.min(rows.length,(RC_TABLE.page+1)*RC_TABLE.pageSize)+' of '+rows.length) : 'No issues in the current calculation'; }
  var cnt=document.getElementById('rcTblCount');
  if(cnt){ cnt.textContent = rows.length+' issues'; }
  var prev=document.getElementById('rcPrevBtn'), next=document.getElementById('rcNextBtn');
  if(prev){ prev.disabled = RC_TABLE.page<=0; }
  if(next){ next.disabled = RC_TABLE.page>=totalPages-1; }
}
function rcSortTable(key){
  if(RC_TABLE.sortKey===key){ RC_TABLE.sortDir=-RC_TABLE.sortDir; }
  else { RC_TABLE.sortKey=key; RC_TABLE.sortDir=(key==='created'||key==='updated'||key==='days_in_status'||key==='id')?-1:1; }
  rcRenderTable();
}
function rcPage(delta){
  var maxPage=Math.max(0, Math.ceil(RC_TABLE.rows.length/RC_TABLE.pageSize)-1);
  RC_TABLE.page=Math.max(0, Math.min(maxPage, RC_TABLE.page+delta));
  rcRenderTable();
}
// [FIX-A0] Boot chain: persisted settings -> PM_DATA rebuild from RC_RAW ->
// first metric render. Deferred to DOMContentLoaded while the DOM is still
// parsing; runs immediately when the script executes after the DOM is ready
// (the script sits at the end of <body>).
function rcBoot(){
  rcSettingsLoad();
  rcRebuildData();   // PM_DATA from RC_RAW + (possibly persisted) settings
  rcSetMetric('cycle');
}
if(document.readyState==='loading'){
  document.addEventListener('DOMContentLoaded', rcBoot);
} else { rcBoot(); }
// [RC-BOOT-END] — QA scripts slice the widget code up to this marker.
// populate dimension dropdowns + first render
olapLinkFillSelect('olapLinkType', 'link_type');
olapLinkFillSelect('olapLinkDir', 'direction');
olapLinkFillSelect('olapLinkSType', 'source_type');
olapLinkFillSelect('olapLinkTType', 'target_type');
olapLinkFillSelect('olapLinkSStatus', 'source_status');
olapLinkFillSelect('olapLinkTStatus', 'target_status');
olapLinkApply();
</script>
</body>
</html>"""
    return html
